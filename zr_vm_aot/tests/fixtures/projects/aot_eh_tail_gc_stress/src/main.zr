let system = import("zr.system");

class Loop {
    pub @call(n: int, acc: int): int {
        if (n == 0) {
            return acc;
        }
        return this(n - 1, acc + 1);
    }
}

fn direct(n: int, acc: int): int {
    if (n == 0) {
        return acc;
    }
    return direct(n - 1, acc + 1);
}

fn guarded(flag: int): int {
    var marker = 0;
    try {
        try {
            if (flag != 0) {
                throw "boom";
            }
            return 0;
        } finally {
            marker = marker + 7;
        }
    } catch (e) {
        return marker + 1;
    }
}

resource class Box {}

var ownerSeed = own Box();
var owner = ownerSeed.share();
var weak = owner.weak();
var alias = weak.upgrade();

var loop = new Loop();
var directValue = direct(12, 0);
var metaValue = loop(10, 0);
var guardedValue = guarded(1);

var releasedOwner = drop(owner);
var releasedAlias = drop(alias);
var after = weak.upgrade();

var spin = 0;
while (spin < 1000) {
    spin = spin + 1;
}

var checksum = directValue + metaValue + guardedValue + spin / 1000;

if (releasedOwner == null && releasedAlias == null && after == null) {
    system.console.printLine("AOT_EH_TAIL_GC_STRESS_PASS");
    system.console.printLine(checksum);
    return checksum;
}

return -1;
