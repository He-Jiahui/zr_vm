let system = import("zr.system");
let container = import("zr.container");

resource class Meter {
    pri var raw: int = 0;

    pub @constructor(start: int) {
        this.raw = start;
    }

    pub property value: int {
        get { return this.raw + 1; }
        set { this.raw = value + 2; }
    }

    pub @call(delta: int): int {
        this.value = this.value + delta;
        return this.value;
    }
}

fn apply(callback, value: int): int {
    return callback(value);
}

var meter = new Meter(4);
var first = meter.value;
meter.value = 6;
var second = meter.value;
var third = apply(meter, 3);

var owner = own Meter(10);
var shared = owner.share();
var weak = shared.weak();
var alias = weak.upgrade();
var releasedShared = drop(shared);
var releasedAlias = drop(alias);
var after = weak.upgrade();

var pair = new container.Pair<int, int>(first, second);
var total = pair.first + pair.second + third;

if (owner == null && releasedShared == null && releasedAlias == null && after == null) {
    system.console.printLine("AOT_DYNAMIC_META_OWNERSHIP_LAB_PASS");
    system.console.printLine(total);
    return total;
}

return -1;
