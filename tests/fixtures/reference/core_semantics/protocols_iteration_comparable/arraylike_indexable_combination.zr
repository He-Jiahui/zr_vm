var builtin = %import("zr.builtin");
var iteration = %import("zr.iteration");

class NeedsArrayLike<T> where T: builtin.IArrayLike<int> { var value: T; }
class NeedsIterable<T> where T: iteration.Iterable<int> { var value: T; }

var xs: int[3] = [1, 2, 3];

new NeedsArrayLike<int[3]>();
new NeedsIterable<int[3]>();
xs[0];
