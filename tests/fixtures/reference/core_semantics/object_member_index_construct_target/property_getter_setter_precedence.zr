class Box {
    pub var raw: int;

    pub @constructor(raw: int) {
        this.raw = raw;
    }

    // 让读写偏移不同，以便运行结果区分属性访问和直接字段访问。
    pub property value: int {
        get { return this.raw + 1; }
        set { this.raw = value + 2; }
    }
}

var box = new Box(3);
var before = box.value;
box.value = 10;
var after = box.value;

return before * 1000 + after * 10 + box.raw;
