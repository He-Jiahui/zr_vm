resource class Session {}
resource class Cache {}

fn runSessionLifecycle(): int {
    var sessionSeed = own Session();
    var sharedSession = sessionSeed.share();
    var watcher = sharedSession.weak();
    var mask = 0;

    {
        var borrowed: ref readonly Session = ref sharedSession;
        if (borrowed != null) {
            mask = mask + 1;
        }
    }

    var cacheSeed = own Cache();
    {
        var loaned: ref Cache = ref cacheSeed;
        if (loaned != null) {
            mask = mask + 2;
        }
    }
    if (cacheSeed != null) {
        mask = mask + 4;
    }

    var detachedSeed = own Session();
    var rawSession = detachedSeed.intoGc();
    if (rawSession != null) {
        mask = mask + 8;
    }

    var upgradedSession = watcher.upgrade();
    if (upgradedSession != null) {
        mask = mask + 16;
    }

    var releasedShared = drop(sharedSession);
    var releasedUpgrade = drop(upgradedSession);
    var expiredSession = watcher.upgrade();
    if (releasedShared == null &&
        releasedUpgrade == null &&
        expiredSession == null) {
        mask = mask + 32;
    }

    return mask;
}

return runSessionLifecycle();
