resource class Session {}
resource class Cache {}

fn runSessionLifecycle(): int {
    var sessionSeed = own Session();
    var sharedSession = share(sessionSeed);
    var watcher = degrade(sharedSession);
    var mask = 0;

    {
        var borrowed: ref readonly Session = ref sharedSession;
        if (borrowed != null) {
            mask = mask + 1;
        }
    }

    var cacheSeed = own Cache();
    {
        var loaned: ref Cache = ref cacheSeed;
        if (loaned != null) {
            mask = mask + 2;
        }
    }
    if (cacheSeed != null) {
        mask = mask + 4;
    }

    var detachedSeed = own Session();
    var rawSession = intoGc(detachedSeed);
    if (rawSession != null) {
        mask = mask + 8;
    }

    var wokenSession = wake(watcher);
    if (wokenSession != null) {
        mask = mask + 16;
    }

    var releasedShared = drop(sharedSession);
    var releasedWoken = drop(wokenSession);
    var expiredSession = wake(watcher);
    if (releasedShared == null &&
        releasedWoken == null &&
        expiredSession == null) {
        mask = mask + 32;
    }

    return mask;
}

return runSessionLifecycle();
