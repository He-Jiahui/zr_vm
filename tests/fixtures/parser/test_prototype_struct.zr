// 测试 struct prototype 生成

// 基本 struct 声明
struct Vector3 {
    pub var x: float;
    pub var y: float;
    pub var z: float;

    pub @constructor(x: float, y: float, z: float){
        this.x = x;
        this.y = y;
        this.z = z;
    }
}

// 带继承的 struct
struct Point2D {
    pub var x: float;
    pub var y: float;
}

struct Point3D {
    pub var x: float;
    pub var y: float;
    pub var z: float;
}

// 带方法的 struct
struct Counter {
    pub var count: int;
    
    pub fn increment(): void {
        this.count = this.count + 1;
    }
}

// 带元函数的 struct
struct TestStruct {
    pub var value: int;

    pub @constructor(v: int) {
        this.value = v;
    }
}

var v = init Vector3(1.0, 2.0, 3.0);
