let {Array} = import("zr.container");
class Actor { pub var n: int = 0; pub fn bump(): void { this.n = this.n + 1; } }
var actors = new Array<Actor>(); actors.add(new Actor());
for (var i = 0; i < actors.length; i += 1) { var a: Actor = actors[i]; a.bump(); }
if (actors[0].n != 1) { throw actors[0].n; }
return 0;
