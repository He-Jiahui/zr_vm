struct Box {
    pub var stored: int;
    pub property x: int {
        get { return this.stored; }
        set { this.stored = value; }
    }
}
struct Outer { pub var box: Box; }
class Holder { pub var box: Box = init Box(); }
fn setBox(box: ref Box) {
    box.x = 42;
    if (box.x != 42) { throw "ref getter after setter"; }
}
fn setNested(outer: ref Outer) { outer.box.x = 42; }
var box = init Box();
setBox(ref box);
if (box.stored != 42) { throw "local ref setter writeback"; }
var holder = new Holder();
setBox(ref holder.box);
if (holder.box.stored != 42) { throw "class field ref setter writeback"; }
var outer = init Outer();
setNested(ref outer);
if (outer.box.stored != 42) { throw "nested ref setter writeback"; }
return 0;
