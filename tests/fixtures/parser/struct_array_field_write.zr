let {Array} = import("zr.container");
struct Vec2 {
    pub var x: float;
    pub var y: float;
    pub @constructor(x: float, y: float) { this.x = x; this.y = y; }
}
var points = new Array<Vec2>();
var initial = init Vec2(1.0, 2.0);
points.add(initial);
points.add(initial);
var copy = points[0];
points[0].x = 9.0;
points[0].y += 3.0;
if (points[0].x != 9.0 || points[0].y != 5.0 || points[1].x != 1.0) {
    throw "element field assignment must write through";
}
if (copy.x != 1.0 || initial.x != 1.0) { throw "field assignment must preserve copies"; }
var indexCalls = 0;
fn nextIndex(): int { indexCalls += 1; return 0; }
points[nextIndex()].x += 1.0;
if (indexCalls != 1 || points[0].x != 10.0) { throw "index must be evaluated once"; }
struct Particle {
    pub var position: Vec2;
    pub @constructor(position: Vec2) { this.position = position; }
}
var particles = new Array<Particle>();
var particle = init Particle(initial);
particles.add(particle);
particles[0].position.x = 17.0;
particles[0].position.y += 4.0;
if (particles[0].position.x != 17.0 || particles[0].position.y != 6.0 || particle.position.x != 1.0) {
    throw "nested element field writeback";
}
return 42;
