let math = import("zr.math");

struct Point {
    pub var x: int;
    pub @constructor(x: int) { this.x = x; }
}
struct Holder { pub var point: Point; }
struct NativeHolder { pub var vector: math.Vector3; }
fn read(point: Point): int { return point.x; }
fn readVector(vector: math.Vector3): float { return vector.y; }
var holder = init Holder();
holder.point = init Point(42);
if (holder.point.x != 42 || read(init Point(7)) != 7) { throw "local init"; }
var vector = init math.Vector3(1.0, 2.0, 3.0);
vector = init math.Vector3(4.0, 5.0, 6.0);
if (vector.x != 4.0 || vector.y != 5.0 || vector.z != 6.0) { throw "native assignment"; }
if (readVector(init math.Vector3(7.0, 8.0, 9.0)) != 8.0) { throw "native expression"; }
var nativeHolder = init NativeHolder();
nativeHolder.vector = init math.Vector3(10.0, 11.0, 12.0);
if (nativeHolder.vector.z != 12.0) { throw "native inline field"; }
return 0;
