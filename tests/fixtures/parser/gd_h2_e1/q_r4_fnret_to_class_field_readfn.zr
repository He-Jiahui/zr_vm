struct Point { pub var x: int; pub @constructor(x: int) { this.x = x; } }
fn make(v: int): Point { return init Point(v); }
fn readX(p: Point): int { return p.x; }
class Box { pub var point: Point = init Point(1); }
var box = new Box();
box.point = make(42);
var r = readX(box.point);
if (r != 42) { throw r; }
return 0;
