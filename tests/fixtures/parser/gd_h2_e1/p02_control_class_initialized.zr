struct Point { pub var x: int; pub @constructor(x: int) { this.x = x; } }
class Box { pub var point: Point = init Point(1); }
var box = new Box();
var constructed = init Point(42);
if (constructed.x != 42) { throw "temporary value"; }
box.point = constructed;
if (box.point.x != 42) { throw box.point.x; }
return 0;
