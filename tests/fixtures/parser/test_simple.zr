// var Vector3 = {x:1,y:2,z:3};

// struct 不允许继承
struct Vector3{
    // 无论是struct 还是class中 声明变量都是明确类型的  不明确类型的就认为是object
    // 可以不进行初始化
    pub var x:float;
    var y:float;
    var z:float = 0;
    var a;
    static var ZERO = init Vector3(0, 0, 0);
    // 构造器等特殊函数会以@开头
    pub @constructor(){
        this.x = 0;
    }
    // 函数重载
    pub @constructor(x:float, y:float, z:float){
        this.x = x;
        this.y = y;
        this.z = z;
    }
    pub static @add(lhs:Vector3, rhs:Vector3){
        // 生成新的Vector3值类型
        // struct 使用 init TypeRef(...) 选择值构造器。
        return lhs;
    }
    pub static @mul(lhs:Vector3, rhs:float){
        // 生成新的Vector3值类型
        return lhs;
    }
    // 函数
    pub fn add(rhs:Vector3): Vector3{
        var lhs = this;
        return lhs;
    }
}
// enum 允许继承 int string float bool
enum RGBA:string{
    R = "R",
    G = "G",
    B = "B",
    A = "A",
}
// 允许声明以;结尾  默认为int 以0,1,2顺序进行
enum Dimension{
    x;
    y;
    z;
}
// 这样声明生成匿名的object
// 可以,进行分隔 或者;进行分隔
var value = {
    a: 1,
    b: 2,
    c: 3
};
var valueX = {
    a: 1;
};
// 可以通过[]对键进行动态运算生成
var value2 = {
    ["a"]: "a";
    b: "b";
    c: "c";
    [2]: "d";
};
var {a, b, c} = value2;
// 数组
var arr = [1, 2, 3];
var arr2:int[] = [1;2;3;];
var arr3 = [1, 2, 3];
var [x] = arr3;
// interface只能当做类型声明 只能声明方法和成员而不实现 会忽略访问性检查
interface Man{
}

class Person{
    pub var id:string;
    pri var _address:string;
    pro var telephone: string;

    pro static var telephone2: string;


    pub @constructor(id: string){
    }
    pub property address: string {
        set { this._address = value; }
        get { return this._address; }
    }

    pub static property address2: string {
        get { return Person.telephone2; }
    }
}
