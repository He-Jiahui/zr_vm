// 测试 class prototype 生成

// 基本 class 声明
class Animal {
    pub var name: string;
    
    pub virtual fn speak(): string {
        return "Some sound";
    }
}

// 带继承的 class
class Dog : Animal {
    pub override fn speak(): string {
        return "Woof";
    }
}

// 带属性的 class
class Person {
    pub var _name: string;
    
    pub property name: string {
        get { return this._name; }
        set { this._name = value; }
    }
}

// 带元函数的 class
class TestClass {
    pub var value: int;
    

    pub @constructor(v: int) {
        this.value = v;
    }

    pub @destructor() {
        this.value = 0;
    }
}


