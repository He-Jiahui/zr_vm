module compile_time_decorator_artifact_baseline;

comptime var BASE_BONUS: int = 5;
comptime var EXTRA_FACTOR: int = 2;

comptime fn decorateWithScale(target: typeof Function, bonus: int = BASE_BONUS, factor: int = EXTRA_FACTOR): zr.DecoratorPatch {
    return {
        metadata: {
            compileTimeTagged: true,
            projectedBonus: bonus * factor
        }
    };
}

comptime var decoratorRegistry = {
    deep: {
        scale: decorateWithScale
    }
};

comptime class TagClass {
    pri var marker: int = BASE_BONUS;

    @constructor(marker: int = BASE_BONUS) {
        this.marker = marker;
    }

    @decorate(target: typeof Class): zr.DecoratorPatch {
        return {
            metadata: {
                compileTimeClassTag: this.marker
            }
        };
    }
}

#TagClass(9)#
pub class User {
}

#decoratorRegistry.deep.scale(factor: 3)#
pub fn score(seed: int = 4): int {
    var fnMeta = typeof(score).metadata;
    var classMeta = typeof(User).metadata;
    var observed = fnMeta;
    observed = classMeta;
    return seed + BASE_BONUS + EXTRA_FACTOR;
}

return score();
