module "decorator_artifact_baseline";

class MarkClass {
    @decorate(target: typeof Class): void {
        target.metadata.runtimeSerializable = true;
    }
}

fn markFunction(target: typeof Function): void {
    target.metadata.instrumented = true;
}

class MarkField {
    @decorate(target: typeof Field): void {
        target.metadata.isRuntimeField = true;
    }
}

class MarkMethod {
    @decorate(target: typeof Method): void {
        target.metadata.isRuntimeMethod = true;
    }
}

class MarkProperty {
    @decorate(target: typeof Property): void {
        target.metadata.isRuntimeProperty = true;
    }
}

#MarkClass#
pub class User {
    #MarkField#
    pub var id: int = 1;

    pri var _value: int = 2;

    #MarkMethod#
    pub load(v: int): int {
        return v;
    }

    #MarkProperty#
    pub property value: int {
        get { return this._value; }
    }
}

#markFunction#
pub verifyDecorators(seed: int = 0): int {
    var typeMeta = typeof(User).metadata;
    var fieldMeta = typeof(User).members.id[0].metadata;
    var methodMeta = typeof(User).members.load[0].metadata;
    var propertyMeta = typeof(User).members.value[0].metadata;
    var functionMeta = typeof(verifyDecorators).metadata;

    if (typeMeta.runtimeSerializable) {
        seed = seed + 1;
    }
    if (fieldMeta.isRuntimeField) {
        seed = seed + 2;
    }
    if (methodMeta.isRuntimeMethod) {
        seed = seed + 4;
    }
    if (propertyMeta.isRuntimeProperty) {
        seed = seed + 8;
    }
    if (functionMeta.instrumented) {
        seed = seed + 16;
    }

    return seed;
}

return verifyDecorators();
