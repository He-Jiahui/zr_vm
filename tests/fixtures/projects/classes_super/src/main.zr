class BaseCounter {
    pub var baseValue: int;

    pub virtual fn bump(): int {
        return this.baseValue + 1;
    }

    pub virtual property score: int {
        get { return this.baseValue + 10; }
    }

    pub virtual @call(): int {
        return this.baseValue + 20;
    }
}

class DerivedCounter: BaseCounter {
    pub override fn bump(): int {
        return super.bump() + 1;
    }

    pub override property score: int {
        get { return super.score + 2; }
    }

    pub override @call(): int {
        return super.call() + 5;
    }

    pub fn total(): int {
        return this.bump() + this.score + this();
    }
}

var counter = new DerivedCounter();
counter.baseValue = 1;
return counter.total();
