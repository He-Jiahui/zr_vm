let testing = import("zr.testing");
let grid = import("lanes/dod/grid");
let world = import("lanes/dod/world");

// Check the observable candidate sequence against dense world order, without
// requiring cell blocks themselves to be globally sorted in backing storage.
fn checkCell(g: grid.Grid, w: world.World, cell: int): void {
    var found = 0; var slot = 0;
    while (slot < w.count) {
        if (g.cell(w.px[slot], w.py[slot]) == cell) {
            testing.assert(g.slots[g.starts[cell] + found] == slot);
            found += 1;
        }
        slot += 1;
    }
    testing.assert(g.counts[cell] == found);
}

#zr.testing.test#
fn stableCandidatesAcrossCellsAndRebuilds(): void {
    var w = new world.World(6); var g = new grid.Grid(6);
    w.add(65.0, 0.0, 1); w.add(1.0, 0.0, 2);
    w.add(66.0, 0.0, 3); w.add(4095.0, 4095.0, 4);
    w.add(67.0, 0.0, 5); w.add(0.0, 64.0, 6);
    g.build(w);
    checkCell(g, w, 0); checkCell(g, w, 1);
    checkCell(g, w, 64); checkCell(g, w, 4095);
    testing.assert(g.counts[2] == 0);
    w.px[0] = 130.0; w.px[2] = 130.0; w.px[4] = 130.0;
    w.swapRemove(1); g.build(w);
    checkCell(g, w, 0); checkCell(g, w, 1); checkCell(g, w, 2);
    checkCell(g, w, 64); checkCell(g, w, 4095);
    testing.assert(g.counts[1] == 0);
    w.count = 0; g.build(w); g.build(w);
    var cell = 0;
    while (cell < 4096) { testing.assert(g.counts[cell] == 0); cell += 1; }
    w.add(4095.0, 4095.0, 7); w.add(-64.0, -64.0, 8); g.build(w);
    checkCell(g, w, 0); checkCell(g, w, 4095);
    testing.assert(g.counts[1] == 0 && g.counts[2] == 0 && g.counts[64] == 0);
}

#zr.testing.test#
fn everyCellAndSingleDenseCell(): void {
    var w = new world.World(4096); var g = new grid.Grid(4096);
    var i = 4095;
    while (i >= 0) {
        // Only the grid columns are needed here; stable-ID registration is
        // covered by the separate real add/swap-removal case above.
        var slot = 4095 - i;
        w.px[slot] = <float>(i % 64) * 64.0;
        w.py[slot] = <float>(i / 64) * 64.0;
        i -= 1;
    }
    w.count = 4096;
    g.build(w); i = 0;
    while (i < 4096) {
        testing.assert(g.counts[i] == 1 && g.slots[g.starts[i]] == 4095 - i);
        w.px[i] = 64.0; w.py[i] = 64.0; i += 1;
    }
    g.build(w);
    testing.assert(g.counts[65] == 4096); i = 0;
    while (i < 4096) {
        testing.assert(g.slots[g.starts[65] + i] == i);
        if (i != 65) { testing.assert(g.counts[i] == 0); }
        i += 1;
    }
}

#zr.testing.test#
fn zeroCapacityAndClampedBoundaries(): void {
    var w = new world.World(0); var g = new grid.Grid(0);
    g.build(w); g.build(w);
    testing.assert(g.counts[0] == 0 && g.counts[4095] == 0);
    testing.assert(g.cell(-1.0, -65.0) == 0);
    testing.assert(g.cell(63.99, 0.0) == 0);
    testing.assert(g.cell(64.0, 64.0) == 65);
    testing.assert(g.cell(4096.0, 5000.0) == 4095);
}
