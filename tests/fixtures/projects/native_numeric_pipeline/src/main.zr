let math = import("zr.math");
let system = import("zr.system");
let lin = import("lin_alg");
let signal = import("signal");
let tensor = import("tensor_pipeline");
let io = import("system_io");
let callbacks = import("callbacks");

var summary = callbacks.runCallbacks(lin, signal, tensor);
var output = io.persistReport(summary);

system.console.printLine("NATIVE_NUMERIC_PIPELINE_PASS " + output.banner);
return output.checksum;
