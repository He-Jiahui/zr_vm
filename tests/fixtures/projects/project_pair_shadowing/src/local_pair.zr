module local_pair;

// 编译器回归使用这个项目内的 Pair 构造器和字段，区别于 zr.container 的同名原生类型。
pub struct Pair {
    pub var left: int;
    pub var right: int;

    pub @constructor(left: int, right: int) {
        this.left = left;
        this.right = right;
    }
}

pub fn score(): int {
    var pair = init Pair(1, 2);
    return pair.left + pair.right;
}
