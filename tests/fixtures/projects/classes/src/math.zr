let {Array} = import("zr.container");

pub struct Point {
    pub var x: float;
    pub var y: float;

    pub @constructor() {
        this.x = 0.0;
        this.y = 0.0;
    }

    pub @constructor(x: float, y: float) {
        this.x = x;
        this.y = y;
    }

    pub static @add(left: Point, right: Point): Point {
        return init Point(left.x + right.x, left.y + right.y);
    }

    pub static @sub(left: Point, right: Point): Point {
        return init Point(left.x - right.x, left.y - right.y);
    }
}

pub resource class PointSet {
    pri var _points: Unique<Array<Point>> = own Array<Point>();

    pub @constructor(capacity: int) {
        this._points.capacity = capacity;
    }

    pub fn resize(size: int) {
        this._points.length = size;
    }

    pub fn addPoint(point: Point) {
        this._points.add(point);
    }

    pub fn insertPoint(index: int, point: Point) {
        this._points.insert(index, point);
    }

    pub static @add_assign(left: Unique<PointSet>, right: Unique<PointSet>): Unique<PointSet> {
        for (var i: int = 0; i < right._points.length; i += 1) {
            left.addPoint(right._points[i]);
        }
        return left;
    }

    pub static @add(left: ref readonly PointSet, right: ref readonly PointSet): Unique<PointSet> {
        var result = own PointSet(0);
        for (var i: int = 0; i < left._points.length; i += 1) {
            result.addPoint(left._points[i]);
        }
        for (var i: int = 0; i < right._points.length; i += 1) {
            result.addPoint(right._points[i]);
        }
        return result;
    }
}

pub class PointSetPool {
    pub static fn take(): Unique<PointSet> {
        return own PointSet(10);
    }

    pub static fn ret(pool: Unique<PointSet>) {
        pool.resize(0);
    }
}

fn takeFromPoolTest(p: Point): Unique<PointSet> {
    var ps = PointSetPool.take();
    ps.addPoint(p);
    return ps;
}

