module decorated_user;

let decorators = import("decorators");
let provider = import("provider");

pub class User {
    pub var id: int = 1;
}

pub fn decoratedBonusComputed(): int {
    return decorators.markFunction(provider.compute(seed: 10, factor: 3));
}

pub fn decoratedBonusDefault(): int {
    return decorators.markFunction(provider.compute(8));
}

pub var verifyDecorators = fn() => {
    return decorators.markClass() + decoratedBonusComputed() + decoratedBonusDefault();
};
