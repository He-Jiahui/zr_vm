module "decorators";

pub markClass(target: typeof Class): void {
    target.metadata.runtimeSerializable = true;
}

pub markFunction(target: typeof Function): void {
    target.metadata.instrumented = true;
}

pub markField(target: typeof Field): void {
    target.metadata.isRuntimeField = true;
}

pub markMethod(target: typeof Method): void {
    target.metadata.isRuntimeMethod = true;
}

pub markProperty(target: typeof Property): void {
    target.metadata.isRuntimeProperty = true;
}
