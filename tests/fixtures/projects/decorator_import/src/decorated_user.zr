module decorated_user;

let decorators = import("decorators");
var markClass = decorators.markClass;
var markField = decorators.markField;
var markMethod = decorators.markMethod;
var markProperty = decorators.markProperty;
var markFunction = decorators.markFunction;

pub class User {
    pub var id: int = 1;

    pri var _value: int = 2;

    pub fn load(v: int): int {
        return v;
    }

    pub property value: int {
        get { return this._value; }
    }
}

pub fn decoratedBonus(): int {
    return markFunction();
}

pub var verifyDecorators = fn() => {
    return markClass() + markField() + markMethod() + markProperty();
};
