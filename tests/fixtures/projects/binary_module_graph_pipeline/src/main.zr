let system = import("zr.system");
let stageA = import("graph_stage_a");
let stageB = import("graph_stage_b");
let binaryStage = import("graph_binary_stage");

var left = <int> stageA.seed();
var right = <int> binaryStage.binarySeed();
var merged = stageB.merge(left, right);

system.console.printLine("BINARY_MODULE_GRAPH_PIPELINE_PASS");
system.console.printLine(merged);
return merged;
