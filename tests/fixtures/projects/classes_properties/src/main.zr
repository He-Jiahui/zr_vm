let console = import("zr.system.console");
let math = import("zr.math");
class PropertyBox {
    pri let _seed: int;
    pri var _value: int = 0;

    pub @constructor(initial: int) {
        this._seed = initial;
        this.initial = initial;
    }

    pri property initial: int {
        init { this._value = value; }
    }

    pub property value: int {
        get { return this._value; }
        set { this._value = value; }
    }

    pub bump(delta: int): int {
        this.value += delta;
        return this.value;
    }

    pub static @add(left: PropertyBox, right: PropertyBox): PropertyBox {
        return new PropertyBox(left.value + right.value);
    }
}

class PropertyStatics {
    pri static var _count: int = 0;

    pub static property count: int {
        get { return PropertyStatics._count; }
        set { PropertyStatics._count = value; }
    }
}

var box = new PropertyBox(10);
box.value += 7;
PropertyStatics.count += box.bump(3);
console.print("box add test: " + (box + box).value + "\n");
console.print("inf test: " + (math.INF + 1) + "\n");
return PropertyStatics.count + box.value;
