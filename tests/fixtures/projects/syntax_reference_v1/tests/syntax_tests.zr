// manifest 的 testSource 指向本目录；样例声明普通测试和两个参数 case。
let testing = import("zr.testing");

#zr.testing.test#
fn syntaxReferencePasses(): void {
    testing.assert(true);
}

#zr.testing.test#
#zr.testing.case(1, 2)#
#zr.testing.case(3, 4)#
fn syntaxReferenceOrdered(left: int, right: int): void {
    testing.assert(left < right);
}
