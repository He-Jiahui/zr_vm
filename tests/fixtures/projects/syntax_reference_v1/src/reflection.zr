let reflection = import("zr.reflection");

struct SyntaxReferenceReflectionPoint {
    pub var x: int;
}

fn syntaxReferenceCreateReflected(typeValue: reflection.Type): object {
    let constructible = reflection.requireConstructible(typeValue);
    return constructible.createInstance(7);
}

fn syntaxReferenceResolvePoint(): reflection.Type {
    return reflection.resolve(typeid(SyntaxReferenceReflectionPoint));
}

fn syntaxReferenceTypeOf(value: object): reflection.TypeOf {
    return typeof(value);
}
