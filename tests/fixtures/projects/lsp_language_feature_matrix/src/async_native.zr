module async_native;

let math = import("zr.math");
let system = import("zr.system");
let network = import("zr.network");
let ffi = import("zr.ffi");
let container = import("zr.container");

resource class Holder {
}

fn makeEscapingCallback(offset: int) {
    var callback = fn(value: int) => {
        return value + offset;
    };
    return callback;
}

pub fn nativeScore(): int {
    var vector = init math.Vector3(1.0, 2.0, 3.0);
    var handle = ffi.BufferHandle.allocate(8);
    var tcp = network.tcp;
    var list = new container.LinkedList<int>();
    var owner = own Holder();
    var shared = share(owner);
    var weak = degrade(shared);
    var wakeView = wake(weak);
    var releasedShared = drop(shared);
    var releasedWakeRef = drop(wakeView);
    var escaped = makeEscapingCallback(5);

    list.addLast(<int> vector.x);
    system.console.printLine("matrix");

    if (handle == null || tcp == null) {
        return -1000;
    }
    if (releasedShared == null && releasedWakeRef == null) {
        return list.count + escaped(2);
    }

    return -1;
}
