// methods
class A {
    pub var s: int;
    pub @constructor() { this.s = 0; }
    pub fn step(d: int): int { this.s = this.s + d; return this.s; }
}
class B {
    pub var s: int;
    pub @constructor() { this.s = 0; }
    pub fn step(d: int): int { this.s = this.s - d; return this.s; }
}
var a = new A();
var b = new B();
var i = 0;
var sum = 0;
while (i < 2000000) {
    if ((i & 1) == 0) {
        sum = sum + a.step(1);
    } else {
        sum = sum + b.step(1);
    }
    i = i + 1;
}
return sum;
