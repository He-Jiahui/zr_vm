# One permanent source, two positive modes and thirty isolated negative modes.
cmake_minimum_required(VERSION 3.20)

if (NOT DEFINED ZR_EXECIR_BOUNDARY_PARAMS OR
        NOT IS_ABSOLUTE "${ZR_EXECIR_BOUNDARY_PARAMS}" OR
        NOT EXISTS "${ZR_EXECIR_BOUNDARY_PARAMS}")
    message(FATAL_ERROR "An existing absolute ExecIR boundary params.cmake is required")
endif ()
include("${ZR_EXECIR_BOUNDARY_PARAMS}")
foreach (_required IN ITEMS SOURCE_ROOT C_COMPILER C_COMPILER_ID
        C_COMPILER_VERSION C_COMPILER_FRONTEND_VARIANT SYSTEM_NAME C_FLAGS
        OUTPUT_ROOT RUN_LABEL)
    if (NOT DEFINED ZR_BOUNDARY_${_required})
        message(FATAL_ERROR "Missing compiler metadata: ${_required}")
    endif ()
endforeach ()
foreach (_path IN ITEMS SOURCE_ROOT C_COMPILER OUTPUT_ROOT)
    if (NOT IS_ABSOLUTE "${ZR_BOUNDARY_${_path}}" OR
            "${ZR_BOUNDARY_${_path}}" MATCHES "[;\r\n]")
        message(FATAL_ERROR "Invalid absolute ${_path}")
    endif ()
endforeach ()
file(TO_CMAKE_PATH "${ZR_BOUNDARY_SOURCE_ROOT}" _source_root)
file(TO_CMAKE_PATH "${ZR_BOUNDARY_OUTPUT_ROOT}" _output_root)
string(TOLOWER "${_source_root}" _source_lower)
if (NOT EXISTS "${ZR_BOUNDARY_C_COMPILER}")
    message(FATAL_ERROR "The recorded physical C compiler is missing")
endif ()
set(_probe "${_source_root}/tests/parser/test_ssa_exec_ir_header_boundary.c")
set(_public "${_source_root}/zr_vm_core/include/zr_vm_core/exec_ir.h")
set(_private "${_source_root}/zr_vm_core/src/zr_vm_core/exec_ir/exec_ir_mutation_internal.h")
if (NOT EXISTS "${_probe}" OR NOT EXISTS "${_public}")
    message(FATAL_ERROR "The real public header or permanent probe is missing")
endif ()

# JSON is metadata only; argv elements retain spaces and native path spelling.
function(_zr_boundary_json out value)
    string(REPLACE "\\" "\\\\" _value "${value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    string(REPLACE "\r" "\\r" _value "${_value}")
    string(REPLACE "\n" "\\n" _value "${_value}")
    string(REPLACE "\t" "\\t" _value "${_value}")
    set(${out} "\"${_value}\"" PARENT_SCOPE)
endfunction()

function(_zr_boundary_array out)
    set(_result "[")
    set(_separator "")
    foreach (_value IN LISTS ARGN)
        _zr_boundary_json(_quoted "${_value}")
        string(APPEND _result "${_separator}${_quoted}")
        set(_separator ",")
    endforeach ()
    string(APPEND _result "]")
    set(${out} "${_result}" PARENT_SCOPE)
endfunction()

# Validate original bytes first. No replacement decoding or CP936 fallback.
function(_zr_boundary_read_utf8 path out_text out_ok)
    file(READ "${path}" _hex HEX)
    set(_ascii "(0[1-9a-f]|[1-7][0-9a-f])")
    set(_tail "[89ab][0-9a-f]")
    set(_two "(c[2-9a-f]|d[0-9a-f])${_tail}")
    set(_three "(e0[ab][0-9a-f]${_tail}|e[1-9abcef]${_tail}${_tail}|ed[89][0-9a-f]${_tail})")
    set(_four "(f0[9ab][0-9a-f]${_tail}${_tail}|f[1-3]${_tail}${_tail}${_tail}|f48[0-9a-f]${_tail}${_tail})")
    if (NOT _hex MATCHES "^(${_ascii}|${_two}|${_three}|${_four})*$")
        set(${out_text} "" PARENT_SCOPE)
        set(${out_ok} FALSE PARENT_SCOPE)
        return()
    endif ()
    file(READ "${path}" _text)
    string(REPLACE "\r\n" "\n" _text "${_text}")
    if (_text MATCHES "\r")
        set(${out_text} "" PARENT_SCOPE)
        set(${out_ok} FALSE PARENT_SCOPE)
        return()
    endif ()
    set(${out_text} "${_text}" PARENT_SCOPE)
    set(${out_ok} TRUE PARENT_SCOPE)
endfunction()

# Extra system include paths in the real C flags are retained. Checkout
# includes may expose only Core/Common public headers in the public modes.
function(_zr_boundary_check_include path private_mode out_ok)
    file(TO_CMAKE_PATH "${path}" _path)
    if (NOT IS_ABSOLUTE "${_path}" OR NOT EXISTS "${_path}")
        set(${out_ok} FALSE PARENT_SCOPE)
        return()
    endif ()
    file(REAL_PATH "${_path}" _path)
    string(TOLOWER "${_path}" _lower)
    string(FIND "${_lower}/" "${_source_lower}/" _inside)
    set(_ok TRUE)
    if (_inside EQUAL 0)
        set(_ok FALSE)
        foreach (_allowed IN ITEMS zr_vm_common/include zr_vm_core/include)
            string(FIND "${_lower}/" "${_source_lower}/${_allowed}/" _found)
            if (_found EQUAL 0)
                set(_ok TRUE)
            endif ()
        endforeach ()
        if (private_mode)
            string(FIND "${_lower}/" "${_source_lower}/zr_vm_core/src/zr_vm_core/" _found)
            if (_found EQUAL 0)
                set(_ok TRUE)
            endif ()
        endif ()
    endif ()
    set(${out_ok} "${_ok}" PARENT_SCOPE)
endfunction()

set(_msvc_frontend FALSE)
if (ZR_BOUNDARY_C_COMPILER_ID STREQUAL "MSVC" OR
        ZR_BOUNDARY_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(_msvc_frontend TRUE)
    separate_arguments(_inherited WINDOWS_COMMAND "${ZR_BOUNDARY_C_FLAGS}")
elseif (ZR_BOUNDARY_C_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
    separate_arguments(_inherited UNIX_COMMAND "${ZR_BOUNDARY_C_FLAGS}")
else ()
    message(FATAL_ERROR "Unsupported C compiler for a declaration boundary check")
endif ()
set(_pending_include FALSE)
foreach (_flag IN LISTS _inherited)
    if (_flag MATCHES ";")
        message(FATAL_ERROR "C flags must not contain list separators")
    endif ()
    string(REGEX REPLACE "^/clang:" "" _analysis "${_flag}")
    string(TOLOWER "${_analysis}" _lower)
    if (_pending_include)
        _zr_boundary_check_include("${_analysis}" FALSE _include_ok)
        if (NOT _include_ok)
            message(FATAL_ERROR "Inherited include path exposes non-public checkout headers")
        endif ()
        set(_pending_include FALSE)
        continue()
    endif ()
    if (_lower MATCHES "^(@|/fi|/yu|/yc|/fp|-include|-imacros|-xclang|-xpreprocessor|-wp,|--config|-specs=)" OR
            _lower MATCHES "^(/wd|/wo|-wno-|-w$)" OR
            _lower MATCHES "^(/fo|/fd|/fe|/fa|/fr|/fm|/sourcedependencies|/ifcoutput|-save-temps|--save-temps|-mf|-mj|-mt|-mq)" OR
            _analysis MATCHES "^(-o|-E|-S|-M|-MD|-MMD|/P|/E|/EP)$")
        message(FATAL_ERROR "Inherited C flag changes admission, diagnostics or outputs: ${_flag}")
    endif ()
    if (_analysis MATCHES "^(-I|/I|-isystem|-iquote|-idirafter|/external:I)$")
        set(_pending_include TRUE)
    elseif (_analysis MATCHES "^(-I|/I|-isystem|-iquote|-idirafter|/external:I)(.+)$")
        _zr_boundary_check_include("${CMAKE_MATCH_2}" FALSE _include_ok)
        if (NOT _include_ok)
            message(FATAL_ERROR "Inherited C flag exposes non-public checkout headers")
        endif ()
    endif ()
endforeach ()
if (_pending_include)
    message(FATAL_ERROR "Inherited C flags end with an incomplete include option")
endif ()

file(READ "${_probe}" _probe_text)
string(FIND "${_probe_text}" "void ZrTests_ExecIr_HeaderBoundaryProbe(void) {" _body_start)
if (_body_start EQUAL -1)
    message(FATAL_ERROR "Permanent header probe body is missing")
endif ()
string(SUBSTRING "${_probe_text}" ${_body_start} -1 _body)
string(FIND "${_body}" "#elif defined(PUBLIC_PRIVATE_SYMBOL)" _body_end)
if (_body_end EQUAL -1)
    message(FATAL_ERROR "Permanent header probe negative branch is missing")
endif ()
string(SUBSTRING "${_body}" 0 ${_body_end} _private_body)
string(REGEX MATCHALL "\\(void\\)sizeof\\(&ZrCore_ExecIr_[A-Za-z0-9_]+\\)" _checks "${_private_body}")
set(_symbols "")
foreach (_check IN LISTS _checks)
    string(REGEX REPLACE "^\\(void\\)sizeof\\(&([A-Za-z0-9_]+)\\)$" "\\1" _symbol "${_check}")
    list(APPEND _symbols "${_symbol}")
endforeach ()
list(LENGTH _symbols _symbol_count)
set(_unique "${_symbols}")
list(REMOVE_DUPLICATES _unique)
list(LENGTH _unique _unique_count)
if (NOT _symbol_count EQUAL 30 OR NOT _unique_count EQUAL 30)
    message(FATAL_ERROR "Permanent header probe must name exactly thirty unique mutations")
endif ()

set(_label "${ZR_BOUNDARY_RUN_LABEL}")
if (_label STREQUAL "")
    string(TIMESTAMP _time "%Y%m%dT%H%M%SZ" UTC)
    string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef _random)
    set(_label "run-${_time}-${_random}")
endif ()
if (NOT _label MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$" OR _label STREQUAL "." OR _label STREQUAL "..")
    message(FATAL_ERROR "ExecIR boundary run label must be a basename")
endif ()
set(_run_dir "${_output_root}/${_label}")
if (EXISTS "${_run_dir}")
    message(FATAL_ERROR "Refusing to overwrite existing boundary evidence: ${_run_dir}")
endif ()
file(MAKE_DIRECTORY "${_run_dir}")
file(SHA256 "${_probe}" _probe_hash)
file(SHA256 "${_public}" _public_hash)
set(_private_hash "absent")
if (EXISTS "${_private}")
    file(SHA256 "${_private}" _private_hash)
endif ()

function(_zr_boundary_inputs_same out)
    file(SHA256 "${_probe}" _p)
    file(SHA256 "${_public}" _u)
    set(_r "absent")
    if (EXISTS "${_private}")
        file(SHA256 "${_private}" _r)
    endif ()
    if (_p STREQUAL _probe_hash AND _u STREQUAL _public_hash AND _r STREQUAL _private_hash)
        set(${out} TRUE PARENT_SCOPE)
    else ()
        set(${out} FALSE PARENT_SCOPE)
    endif ()
endfunction()

# Return categories only; original compiler bytes remain in the two raw logs.
function(_zr_boundary_analyze text symbol private_mode out_issues out_errors out_headers)
    set(_issues "")
    set(_errors 0)
    set(_headers "")
    set(_context "")
    string(REPLACE ";" "\\;" _lines "${text}")
    string(REPLACE "\n" ";" _lines "${_lines}")
    foreach (_line IN LISTS _lines)
        if (_line STREQUAL "")
            continue()
        endif ()
        if (_line MATCHES "^[ ]*(Note: including file:|注意: 包含文件:)[ ]+(.+)$")
            set(_header "${CMAKE_MATCH_2}")
            string(STRIP "${_header}" _header)
            _zr_boundary_check_include("${_header}" "${private_mode}" _allowed)
            if (NOT _allowed)
                list(APPEND _issues "unadmitted include path")
            endif ()
            list(APPEND _headers "${_header}")
            continue()
        endif ()
        string(TOLOWER "${_line}" _lower)
        if (_lower MATCHES "(^|[ :])warning([ :]|[a-z][0-9])")
            list(APPEND _issues "compiler warning")
            continue()
        endif ()
        if (_lower MATCHES "(^|[ :])(fatal[ ]+)?error(:|[ ]+[a-z][0-9]+:)")
            math(EXPR _errors "${_errors}+1")
            set(_expected FALSE)
            if (NOT symbol STREQUAL "" AND
                    _line MATCHES "test_ssa_exec_ir_header_boundary\\.c[(:]" AND
                    _line MATCHES "(^|[^A-Za-z0-9_])${symbol}([^A-Za-z0-9_]|$)")
                if (ZR_BOUNDARY_C_COMPILER_ID STREQUAL "MSVC")
                    if (_line MATCHES "error C2065:")
                        set(_expected TRUE)
                    endif ()
                elseif (_line MATCHES "undeclared")
                    set(_expected TRUE)
                endif ()
            endif ()
            if (NOT _expected)
                list(APPEND _issues "unexpected primary compiler error")
            endif ()
            continue()
        endif ()
        if (_line STREQUAL "test_ssa_exec_ir_header_boundary.c" OR
                _line STREQUAL "${_probe}")
            continue()
        endif ()
        string(REPLACE ";" "\\;" _context_line "${_line}")
        list(APPEND _context "${_context_line}")
    endforeach ()
    foreach (_line IN LISTS _context)
        if (NOT symbol STREQUAL "" AND _errors GREATER 0 AND
                (_line MATCHES "^[ ]*[0-9]+[ ]*\\|" OR
                 _line MATCHES "^[ ]*\\|" OR
                 _line MATCHES "^[ ]*[~^]+[ ~^]*$" OR
                 _line MATCHES "^[ ]*\\(void\\)sizeof\\(&PUBLIC_PRIVATE_SYMBOL\\);[ ]*$" OR
                 _line MATCHES "^[ ]*#define PUBLIC_PRIVATE_SYMBOL ${symbol}[ ]*$" OR
                 _line MATCHES ":[ ]*note:" OR
                 _line MATCHES "^[0-9]+ errors? generated\\.$"))
            continue()
        endif ()
        list(APPEND _issues "unknown compiler output")
    endforeach ()
    set(${out_issues} "${_issues}" PARENT_SCOPE)
    set(${out_errors} "${_errors}" PARENT_SCOPE)
    set(${out_headers} "${_headers}" PARENT_SCOPE)
endfunction()

set(_base "${ZR_BOUNDARY_C_COMPILER}")
list(APPEND _base ${_inherited})
if (_msvc_frontend)
    # Retain the configured language mode without repeating clang-cl /TC.
    list(FIND _inherited "/TC" _tc_index)
    if (_tc_index EQUAL -1)
        list(APPEND _base /TC)
    endif ()
    list(APPEND _base /nologo /Zs /std:c11 /W4 /WX /utf-8 /UNDEBUG /FC /showIncludes
            /DZR_LIBRARY_TYPE_STATIC=1 /DZR_LIBRARY_TYPE_SHARED=0
            "/I${_source_root}/zr_vm_common/include" "/I${_source_root}/zr_vm_core/include")
    if (ZR_BOUNDARY_C_COMPILER_ID STREQUAL "MSVC")
        list(APPEND _base /experimental:c11atomics)
    endif ()
    if (ZR_BOUNDARY_SYSTEM_NAME STREQUAL "Windows")
        list(APPEND _base /DWIN32 /D_WINDOWS /DZR_PLATFORM_WIN=1)
    endif ()
else ()
    list(APPEND _base -fsyntax-only -x c -std=c11 -Wall -Wextra -Werror -UNDEBUG
            -DZR_LIBRARY_TYPE_STATIC=1 -DZR_LIBRARY_TYPE_SHARED=0
            "-I${_source_root}/zr_vm_common/include" "-I${_source_root}/zr_vm_core/include")
    if (ZR_BOUNDARY_SYSTEM_NAME STREQUAL "Windows")
        list(APPEND _base -DWIN32 -D_WINDOWS -DZR_PLATFORM_WIN=1)
    endif ()
endif ()
unset(ENV{CL})
unset(ENV{_CL_})
unset(ENV{LINK})
unset(ENV{_LINK_})
set(ENV{LC_ALL} C)
set(ENV{LANG} C)
set(ENV{TEMP} "${_run_dir}")
set(ENV{TMP} "${_run_dir}")
set(ENV{TMPDIR} "${_run_dir}")
set(_phases "")
set(_separator "")
set(_passed 0)
set(_actual 0)
foreach (_index RANGE 0 31)
    set(_command "${_base}")
    set(_symbol "")
    set(_private_mode FALSE)
    if (_index EQUAL 0)
        set(_name public)
    elseif (_index EQUAL 1)
        set(_name private)
        set(_private_mode TRUE)
        if (_msvc_frontend)
            list(APPEND _command /DPRIVATE_HEADER=1 "/I${_source_root}/zr_vm_core/src/zr_vm_core")
        else ()
            list(APPEND _command -DPRIVATE_HEADER=1 "-I${_source_root}/zr_vm_core/src/zr_vm_core")
        endif ()
    else ()
        math(EXPR _symbol_index "${_index}-2")
        list(GET _symbols ${_symbol_index} _symbol)
        math(EXPR _number "${_symbol_index}+1")
        if (_number LESS 10)
            set(_number "0${_number}")
        endif ()
        set(_name "negative-${_number}")
        if (_msvc_frontend)
            list(APPEND _command "/DPUBLIC_PRIVATE_SYMBOL=${_symbol}")
        else ()
            list(APPEND _command "-DPUBLIC_PRIVATE_SYMBOL=${_symbol}")
        endif ()
    endif ()
    list(APPEND _command "${_probe}")
    _zr_boundary_array(_argv ${_command})
    set(_prefix "${_run_dir}/${_name}")
    file(WRITE "${_prefix}.command.json" "${_argv}\n")
    _zr_boundary_inputs_same(_before_same)
    if (NOT _before_same)
        message(FATAL_ERROR "Header/probe input changed before ${_name}; existing evidence is retained")
    endif ()
    execute_process(COMMAND ${_command}
            WORKING_DIRECTORY "${_run_dir}"
            OUTPUT_FILE "${_prefix}.stdout.log" ERROR_FILE "${_prefix}.stderr.log"
            RESULT_VARIABLE _exit)
    math(EXPR _actual "${_actual}+1")
    _zr_boundary_inputs_same(_after_same)
    _zr_boundary_read_utf8("${_prefix}.stdout.log" _stdout _stdout_ok)
    _zr_boundary_read_utf8("${_prefix}.stderr.log" _stderr _stderr_ok)
    _zr_boundary_analyze("${_stdout}" "${_symbol}" "${_private_mode}" _out_issues _out_errors _out_headers)
    _zr_boundary_analyze("${_stderr}" "${_symbol}" "${_private_mode}" _err_issues _err_errors _err_headers)
    set(_issues ${_out_issues} ${_err_issues})
    math(EXPR _errors "${_out_errors}+${_err_errors}")
    if (NOT _after_same)
        list(APPEND _issues "header/probe input changed during compilation")
    endif ()
    if (NOT _stdout_ok OR NOT _stderr_ok)
        list(APPEND _issues "raw output is not strict UTF-8 text")
    endif ()
    set(_natural FALSE)
    if ("${_exit}" MATCHES "^[0-9]+$" AND _exit LESS 256)
        set(_natural TRUE)
    endif ()
    if (NOT _natural)
        list(APPEND _issues "compiler did not return a normal numeric exit")
    elseif (_symbol STREQUAL "")
        if (NOT _exit EQUAL 0 OR NOT _errors EQUAL 0)
            list(APPEND _issues "positive header mode did not compile cleanly")
        endif ()
    elseif (_exit EQUAL 0 OR NOT _errors EQUAL 1)
        list(APPEND _issues "public mutation was not rejected as undeclared")
    endif ()
    set(_headers ${_out_headers} ${_err_headers})
    list(REMOVE_DUPLICATES _headers)
    list(SORT _headers)
    _zr_boundary_array(_header_json ${_headers})
    _zr_boundary_array(_issues_json ${_issues})
    _zr_boundary_json(_exit_json "${_exit}")
    _zr_boundary_json(_symbol_json "${_symbol}")
    file(SHA256 "${_prefix}.stdout.log" _stdout_hash)
    file(SHA256 "${_prefix}.stderr.log" _stderr_hash)
    file(SIZE "${_prefix}.stdout.log" _stdout_bytes)
    file(SIZE "${_prefix}.stderr.log" _stderr_bytes)
    set(_ok false)
    set(_natural_json false)
    if (_natural)
        set(_natural_json true)
    endif ()
    if (NOT _issues)
        set(_ok true)
        math(EXPR _passed "${_passed}+1")
    endif ()
    set(_phase "{\"name\":\"${_name}\",\"symbol\":${_symbol_json},\"exit\":${_exit_json},\"natural_exit\":${_natural_json},\"accepted\":${_ok},\"primary_errors\":${_errors},\"issues\":${_issues_json},\"actual_headers\":${_header_json},\"stdout_bytes\":${_stdout_bytes},\"stdout_sha256\":\"${_stdout_hash}\",\"stderr_bytes\":${_stderr_bytes},\"stderr_sha256\":\"${_stderr_hash}\"}")
    file(WRITE "${_prefix}.result.json" "${_phase}\n")
    string(APPEND _phases "${_separator}${_phase}")
    set(_separator ",\n")
endforeach ()
set(_success false)
if (_passed EQUAL 32 AND _actual EQUAL 32)
    set(_success true)
endif ()
_zr_boundary_json(_compiler_json "${ZR_BOUNDARY_C_COMPILER}")
_zr_boundary_json(_compiler_id_json "${ZR_BOUNDARY_C_COMPILER_ID}")
_zr_boundary_json(_compiler_version_json "${ZR_BOUNDARY_C_COMPILER_VERSION}")
_zr_boundary_json(_frontend_json "${ZR_BOUNDARY_C_COMPILER_FRONTEND_VARIANT}")
_zr_boundary_json(_system_json "${ZR_BOUNDARY_SYSTEM_NAME}")
_zr_boundary_json(_flags_json "${ZR_BOUNDARY_C_FLAGS}")
file(WRITE "${_run_dir}/receipt.json"
        "{\"schema_version\":1,\"success\":${_success},\"credit\":\"header-syntax-only\",\"object_link_runtime_credit\":false,\"source_copies_created\":false,\"raw_encoding\":\"strict UTF-8\",\"compiler\":${_compiler_json},\"compiler_id\":${_compiler_id_json},\"compiler_version\":${_compiler_version_json},\"frontend\":${_frontend_json},\"system\":${_system_json},\"inherited_C_FLAGS\":${_flags_json},\"probe_sha256\":\"${_probe_hash}\",\"public_header_sha256\":\"${_public_hash}\",\"private_header_sha256\":\"${_private_hash}\",\"actual_compiler_invocations\":${_actual},\"accepted_modes\":${_passed},\"phases\":[\n${_phases}\n]}\n")
if (NOT _success)
    message(FATAL_ERROR "ExecIR header boundary rejected: ${_passed}/32 modes; evidence: ${_run_dir}")
endif ()
message(STATUS "ExecIR header boundary accepted: public/private/30 isolated negatives; header syntax only; evidence: ${_run_dir}")
