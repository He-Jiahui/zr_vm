# 环境捕获 wrapper 负责最终报告；套件只读取已有快照并将尚未完成的隔离状态标成 provisional。
# Windows 当前没有等价的亲和性证据，因此调用方只能将其结果列为不可比较。

# 主套件和定向契约测试共享此判定；valid 表示输入报告可解释，comparable 表示有最终隔离证据。
# report_path 来自调用方配置，输出 JSON 中仍包含该路径。
# BUG: Linux 上已存在的报告路径若含双引号，这里的直接插值会使最终 benchmark_report.json 无效；
# run_performance_suite.cmake 从环境变量接收路径并原样嵌入本函数结果，须对 JSON 字符串转义。
function(zr_benchmark_task4_resolve_environment
        platform_name
        report_path
        out_valid
        out_comparable
        out_json
        out_issue)
    set(valid TRUE)
    set(comparable FALSE)
    set(issue "")
    if (platform_name STREQUAL "Windows")
        set(status "INCOMPARABLE")
        set(reason "WINDOWS_NATIVE_AFFINITY_CAPTURE_UNAVAILABLE")
        set(json "{\"status\":\"INCOMPARABLE\",\"reasons\":[\"${reason}\"],\"report_path\":null}")
    elseif (report_path STREQUAL "")
        set(valid FALSE)
        set(issue "ENVIRONMENT_REPORT_REQUIRED")
        set(status "INCOMPARABLE")
        set(json "{\"status\":\"INCOMPARABLE\",\"reasons\":[\"${issue}\"],\"report_path\":null}")
    elseif (NOT EXISTS "${report_path}")
        set(valid FALSE)
        set(issue "ENVIRONMENT_REPORT_MISSING")
        set(status "INCOMPARABLE")
        set(json "{\"status\":\"INCOMPARABLE\",\"reasons\":[\"${issue}\"],\"report_path\":null}")
    else ()
        file(READ "${report_path}" environment_text)
        string(JSON capture_status ERROR_VARIABLE capture_error GET "${environment_text}" capture_status)
        if (capture_error OR capture_status STREQUAL "")
            set(valid FALSE)
            set(issue "ENVIRONMENT_REPORT_INVALID")
            set(json "{\"status\":\"INCOMPARABLE\",\"reasons\":[\"${issue}\"],\"report_path\":\"${report_path}\"}")
        elseif (capture_status STREQUAL "IN_PROGRESS")
            string(JSON provisional_isolation ERROR_VARIABLE provisional_error GET "${environment_text}" isolation status)
            if (NOT provisional_error AND provisional_isolation STREQUAL "NON_ISOLATED")
                set(status "INCOMPARABLE")
                set(reason "NON_ISOLATED")
                set(json "{\"status\":\"${status}\",\"reasons\":[\"${reason}\"],\"report_path\":\"${report_path}\"}")
            else ()
                set(status "PENDING_FINALIZATION")
                set(reason "ENVIRONMENT_PENDING_FINALIZATION")
                set(json "{\"status\":\"${status}\",\"reasons\":[\"${reason}\"],\"report_path\":\"${report_path}\"}")
            endif ()
        elseif (capture_status STREQUAL "COMPLETE")
            string(JSON isolation_status ERROR_VARIABLE isolation_error GET "${environment_text}" isolation status)
            string(JSON fingerprint ERROR_VARIABLE fingerprint_error GET "${environment_text}" stable_fingerprint value)
            if (isolation_error OR fingerprint_error OR isolation_status STREQUAL "")
                set(status "INCOMPARABLE")
                set(reason "ENVIRONMENT_FINGERPRINT_OR_ISOLATION_MISSING")
                set(json "{\"status\":\"${status}\",\"reasons\":[\"${reason}\"],\"report_path\":\"${report_path}\"}")
            elseif (isolation_status STREQUAL "ISOLATED")
                set(comparable TRUE)
                set(status "COMPARABLE")
                set(json "{\"status\":\"${status}\",\"reasons\":[],\"fingerprint\":\"${fingerprint}\",\"isolation_status\":\"${isolation_status}\",\"report_path\":\"${report_path}\"}")
            else ()
                set(status "INCOMPARABLE")
                set(reason "NON_ISOLATED")
                set(json "{\"status\":\"${status}\",\"reasons\":[\"${reason}\"],\"fingerprint\":\"${fingerprint}\",\"isolation_status\":\"${isolation_status}\",\"report_path\":\"${report_path}\"}")
            endif ()
        else ()
            set(valid FALSE)
            set(issue "ENVIRONMENT_CAPTURE_STATUS_INVALID")
            set(json "{\"status\":\"INCOMPARABLE\",\"reasons\":[\"${issue}\"],\"report_path\":\"${report_path}\"}")
        endif ()
    endif ()
    set(${out_valid} ${valid} PARENT_SCOPE)
    set(${out_comparable} ${comparable} PARENT_SCOPE)
    set(${out_json} "${json}" PARENT_SCOPE)
    set(${out_issue} "${issue}" PARENT_SCOPE)
endfunction()
