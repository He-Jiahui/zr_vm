# Filter a compiled COFF archive for the direct Function ownership test.
# No repository source is copied or reconstructed by this build step.
cmake_minimum_required(VERSION 3.21)
foreach (_required IN ITEMS INPUT OUTPUT ARCHIVE_ROOT ARCHIVER EXCLUDED_BASENAMES)
    if (NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Missing archive argument: ${_required}")
    endif ()
endforeach ()
file(REAL_PATH "${ARCHIVE_ROOT}" _root)
file(REAL_PATH "${INPUT}" _input)
if (IS_SYMLINK "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}.members.tsv"
        OR IS_DIRECTORY "${OUTPUT}" OR IS_DIRECTORY "${OUTPUT}.members.tsv")
    message(FATAL_ERROR "Derived archive and metadata must be regular files")
endif ()
get_filename_component(_output_parent "${OUTPUT}" DIRECTORY)
get_filename_component(_output_name "${OUTPUT}" NAME)
file(REAL_PATH "${_output_parent}" _output_parent)
set(_output "${_output_parent}/${_output_name}")
foreach (_path IN ITEMS _input _output)
    cmake_path(IS_PREFIX _root "${${_path}}" NORMALIZE _inside)
    if (NOT _inside OR IS_SYMLINK "${${_path}}")
        message(FATAL_ERROR "Archive path must remain in the actual build directory")
    endif ()
endforeach ()
if (_input STREQUAL _output OR NOT EXISTS "${_input}" OR IS_DIRECTORY "${_input}")
    message(FATAL_ERROR "Archive input and derived output must be distinct regular files")
endif ()
list(LENGTH EXCLUDED_BASENAMES _excluded_count)
list(REMOVE_DUPLICATES EXCLUDED_BASENAMES)
list(LENGTH EXCLUDED_BASENAMES _unique_count)
if (NOT _excluded_count EQUAL 16 OR NOT _unique_count EQUAL 16)
    message(FATAL_ERROR "Expected 16 distinct private provider names")
endif ()
function(_zr_archive_members archive result)
    execute_process(COMMAND "${ARCHIVER}" t "${archive}"
            RESULT_VARIABLE _exit OUTPUT_VARIABLE _text ERROR_VARIABLE _error)
    if (NOT _exit EQUAL 0 OR NOT _error STREQUAL "")
        message(FATAL_ERROR "Archive inventory failed (${_exit}): ${_error}")
    endif ()
    string(REPLACE "\r\n" "\n" _text "${_text}")
    string(REGEX REPLACE "\n$" "" _text "${_text}")
    string(REPLACE "\n" ";" _members "${_text}")
    set(${result} "${_members}" PARENT_SCOPE)
endfunction()
file(SHA256 "${_input}" _input_hash)
_zr_archive_members("${_input}" _members)
set(_removed)
set(_retained)
foreach (_member IN LISTS _members)
    get_filename_component(_basename "${_member}" NAME)
    if (_basename IN_LIST EXCLUDED_BASENAMES)
        list(APPEND _removed "${_member}")
    else ()
        list(APPEND _retained "${_member}")
    endif ()
endforeach ()
foreach (_expected IN LISTS EXCLUDED_BASENAMES)
    set(_found 0)
    foreach (_member IN LISTS _removed)
        get_filename_component(_basename "${_member}" NAME)
        if (_basename STREQUAL _expected)
            math(EXPR _found "${_found} + 1")
        endif ()
    endforeach ()
    if (NOT _found EQUAL 1)
        message(FATAL_ERROR "Expected one ordinary provider: ${_expected}; found ${_found}")
    endif ()
endforeach ()
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "${_input}" "${_output}"
        RESULT_VARIABLE _copy_exit)
if (NOT _copy_exit EQUAL 0)
    message(FATAL_ERROR "Derived archive copy failed: ${_copy_exit}")
endif ()
# P matches complete member paths; s rebuilds the archive symbol index.
execute_process(COMMAND "${ARCHIVER}" --format=coff dsP "${_output}" ${_removed}
        RESULT_VARIABLE _edit_exit OUTPUT_VARIABLE _edit_text ERROR_VARIABLE _edit_error)
if (NOT _edit_exit EQUAL 0 OR NOT _edit_error STREQUAL "")
    message(FATAL_ERROR "Derived archive edit failed (${_edit_exit}): ${_edit_error}")
endif ()
_zr_archive_members("${_output}" _actual)
if (NOT "${_actual}" STREQUAL "${_retained}")
    message(FATAL_ERROR "Residual archive differs from the exact ordered retained inventory")
endif ()
file(SHA256 "${_input}" _after_hash)
if (NOT _after_hash STREQUAL _input_hash)
    message(FATAL_ERROR "Ordinary Core archive changed during filtering")
endif ()
file(SHA256 "${_output}" _output_hash)
set(_metadata "kind\tvalue\ninput_sha256\t${_input_hash}\noutput_sha256\t${_output_hash}\n")
string(APPEND _metadata "inventory_before_exit\t0\ncopy_exit\t${_copy_exit}\nedit_exit\t${_edit_exit}\ninventory_after_exit\t0\n")
foreach (_member IN LISTS _members)
    string(APPEND _metadata "input_member\t${_member}\n")
endforeach ()
foreach (_member IN LISTS _removed)
    string(APPEND _metadata "excluded_member\t${_member}\n")
endforeach ()
foreach (_member IN LISTS _actual)
    string(APPEND _metadata "residual_member\t${_member}\n")
endforeach ()
file(WRITE "${_output}.members.tsv" "${_metadata}")
