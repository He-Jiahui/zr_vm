cmake_minimum_required(VERSION 3.31)
# Validate the actual negative run, preserving child exit and both raw streams.
if (NOT DEFINED ZR_CLEANUP_EXECUTABLE OR NOT EXISTS "${ZR_CLEANUP_EXECUTABLE}"
        OR NOT DEFINED ZR_CLEANUP_OUTPUT_DIR
        OR NOT ZR_CLEANUP_EXPECTED_PHASE MATCHES "^(RED|GREEN)$")
    message(FATAL_ERROR "Supply an actual cleanup executable, output directory and exact phase")
endif ()
cmake_path(ABSOLUTE_PATH ZR_CLEANUP_OUTPUT_DIR NORMALIZE OUTPUT_VARIABLE _output)
cmake_path(ABSOLUTE_PATH ZR_CLEANUP_EXECUTABLE NORMALIZE OUTPUT_VARIABLE _executable)
cmake_path(IS_PREFIX _output "${_executable}" NORMALIZE _executable_allowed)
if (NOT _executable_allowed
        OR NOT IS_DIRECTORY "${_output}")
    message(FATAL_ERROR "Use the actual executable inside the configured build directory")
endif ()
set(_stdout_path "${_output}/returned-execir-cleanup-${ZR_CLEANUP_EXPECTED_PHASE}-stdout.log")
set(_stderr_path "${_output}/returned-execir-cleanup-${ZR_CLEANUP_EXPECTED_PHASE}-stderr.log")

execute_process(COMMAND "${_executable}" WORKING_DIRECTORY "${_output}"
        RESULT_VARIABLE _exit OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr
        TIMEOUT 120 ENCODING UTF-8)
file(WRITE "${_stdout_path}" "${_stdout}")
file(WRITE "${_stderr_path}" "${_stderr}")
message("RETURNED_EXEC_CLEANUP_CHILD phase=${ZR_CLEANUP_EXPECTED_PHASE} actual_exit=${_exit}")
message("${_stdout}")
message("${_stderr}")
if (ZR_CLEANUP_EXPECTED_PHASE STREQUAL "RED")
    set(_expected_exit 6)
    set(_expected_failures 6)
    set(_completed 0)
else ()
    set(_expected_exit 2)
    set(_expected_failures 2)
    set(_completed 1)
endif ()
if (NOT "${_exit}" STREQUAL "${_expected_exit}")
    message(FATAL_ERROR "Unexpected actual Unity exit; raw streams retained")
endif ()
string(REPLACE "\r\n" "\n" _stderr_normal "${_stderr}")
string(STRIP "${_stderr_normal}" _stderr_normal)
if (NOT _stderr_normal STREQUAL "EXEC_OWNER_LEDGER errors=1 live=1")
    message(FATAL_ERROR "Expected exactly one genuine residual owner-recovery diagnostic")
endif ()
string(REPLACE "\r\n" "\n" _stdout_normal "${_stdout}")
if (_stdout_normal MATCHES "runtime error:|UndefinedBehaviorSanitizer|[Ww]arning:")
    message(FATAL_ERROR "Unexpected warning or sanitizer diagnostic")
endif ()
set(_names
        test_healthy_registered_ledger_close
        test_prior_unity_failure_still_finishes_cleanup
        test_prior_failure_saved_witnesses_are_complete
        test_residual_cleanup_cannot_become_healthy
        test_residual_saved_health_and_failure_remain_visible
        test_repeated_close_preserves_original_failure_report)
set(_result_count 0)
set(_case_count 0)
set(_summary_count 0)
set(_final_count 0)
set(_footer_count 0)
set(_failure_count 0)
string(REGEX MATCHALL "[^\n]+" _lines "${_stdout_normal}")
foreach (_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if (_line STREQUAL "")
        continue()
    endif ()
    if (_line MATCHES "^.*test_ssa_source_returned_execir_cleanup[.]c:[0-9]+:(test_[a-z_]+):(PASS|FAIL|IGNORE)(:(.*))?$")
        if (_result_count GREATER_EQUAL 6 OR NOT _result_count EQUAL _case_count
                OR _final_count OR _summary_count)
            message(FATAL_ERROR "Unexpected result count/order")
        endif ()
        set(_name "${CMAKE_MATCH_1}")
        set(_result "${CMAKE_MATCH_2}")
        set(_reason "${CMAKE_MATCH_4}")
        list(GET _names ${_result_count} _expected_name)
        math(EXPR _number "${_result_count}+1")
        if (_number EQUAL 2)
            set(_expected_result FAIL)
            set(_expected_reason RETURNED_EXEC_CLEANUP_PRIOR_FAILURE)
        elseif (ZR_CLEANUP_EXPECTED_PHASE STREQUAL "RED")
            set(_expected_result FAIL)
            set(_expected_reason RETURNED_EXEC_CLEANUP_MISSING_COMPLETION)
        elseif (_number EQUAL 4)
            set(_expected_result FAIL)
            set(_expected_reason RETURNED_EXEC_CLEANUP_PREHEALTH)
        else ()
            set(_expected_result PASS)
            set(_expected_reason "")
        endif ()
        if (NOT _name STREQUAL _expected_name OR NOT _result STREQUAL _expected_result
                OR NOT _reason STREQUAL _expected_reason)
            message(FATAL_ERROR "Unexpected exact case name/result/reason at ${_number}")
        endif ()
        if (_result STREQUAL "FAIL")
            math(EXPR _failure_count "${_failure_count}+1")
        endif ()
        math(EXPR _result_count "${_result_count}+1")
    elseif (_line MATCHES "^RETURNED_EXEC_CLEANUP_CASE ")
        math(EXPR _number "${_case_count}+1")
        if (_case_count GREATER_EQUAL 6 OR NOT _result_count EQUAL _number OR _final_count)
            message(FATAL_ERROR "Unexpected saved-case witness order")
        endif ()
        set(_prior_failed 0)
        set(_before_live 0)
        set(_after_errors 0)
        if (_number EQUAL 1)
            set(_lifecycle 1)
        elseif (_number LESS_EQUAL 3)
            set(_lifecycle 2)
            set(_prior_failed 1)
        else ()
            set(_lifecycle 3)
            set(_before_live 3)
            set(_after_errors 3)
        endif ()
        set(_healthy 0)
        if (ZR_CLEANUP_EXPECTED_PHASE STREQUAL "GREEN" AND _number LESS_EQUAL 3)
            set(_healthy 1)
        endif ()
        set(_expected_case "RETURNED_EXEC_CLEANUP_CASE case=${_number} lifecycle=${_lifecycle} completed=${_completed} healthy=${_healthy} prior_failed=${_prior_failed} prior_ignored=0 flags_preserved=1 closed=1 support=1 before_live=${_before_live} after_live=0 before_errors=0 after_errors=${_after_errors} queries=6 record_frees=3")
        if (NOT _line STREQUAL _expected_case)
            message(FATAL_ERROR "Unexpected saved cleanup/support witness at ${_number}")
        endif ()
        math(EXPR _case_count "${_case_count}+1")
    elseif (_line STREQUAL "RETURNED_EXEC_CLEANUP_FINAL drain=1 live=0 record_frees=3 errors=3 flags_preserved=1")
        if (NOT _result_count EQUAL 6 OR NOT _case_count EQUAL 6 OR _final_count OR _summary_count)
            message(FATAL_ERROR "Unexpected final-drain witness order/count")
        endif ()
        math(EXPR _final_count "${_final_count}+1")
    elseif (_line STREQUAL "6 Tests ${_expected_failures} Failures 0 Ignored")
        if (NOT _final_count EQUAL 1 OR _summary_count)
            message(FATAL_ERROR "Unexpected actual Unity summary order/count")
        endif ()
        math(EXPR _summary_count "${_summary_count}+1")
    elseif (_line STREQUAL "FAIL")
        if (NOT _summary_count EQUAL 1 OR _footer_count)
            message(FATAL_ERROR "Unexpected actual Unity failure footer")
        endif ()
        math(EXPR _footer_count "${_footer_count}+1")
    elseif (_line MATCHES "^-+$")
        if (NOT _final_count EQUAL 1 OR _summary_count)
            message(FATAL_ERROR "Unexpected Unity summary separator")
        endif ()
    else ()
        message(FATAL_ERROR "Unexpected cleanup stdout line: ${_line}")
    endif ()
endforeach ()
if (NOT _result_count EQUAL 6 OR NOT _case_count EQUAL 6 OR NOT _summary_count EQUAL 1
        OR NOT _final_count EQUAL 1 OR NOT _footer_count EQUAL 1
        OR NOT _failure_count EQUAL _expected_failures)
    message(FATAL_ERROR "Incomplete exact cleanup negative-run protocol")
endif ()
message("RETURNED_EXEC_CLEANUP_PROTOCOL_ACCEPTED phase=${ZR_CLEANUP_EXPECTED_PHASE} cases=6 expected_failures=${_expected_failures} ignored=0 actual_exit=${_exit}")
