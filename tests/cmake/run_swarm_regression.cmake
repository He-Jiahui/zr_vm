# Each mode gets a private project. Binary execution must work without source.
file(REMOVE_RECURSE "${TEST_WORK_DIR}")
file(MAKE_DIRECTORY "${TEST_WORK_DIR}/src")
configure_file("${SOURCE_FILE}" "${TEST_WORK_DIR}/src/main.zr" COPYONLY)
set(project "${TEST_WORK_DIR}/probe.zrp")
file(WRITE "${project}" "{\"name\":\"swarm_regression\",\"source\":\"src\",\"binary\":\"bin\",\"entry\":\"main\"}\n")
if(DEFINED PLUGIN_FILE)
    file(MAKE_DIRECTORY "${TEST_WORK_DIR}/native")
    configure_file("${PLUGIN_FILE}" "${TEST_WORK_DIR}/native/${PLUGIN_NAME}" COPYONLY)
endif()
if(EXECUTION_MODE STREQUAL "binary")
    execute_process(COMMAND "${CLI_EXE}" --compile "${project}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 40)
    if(NOT status EQUAL 0 OR NOT EXISTS "${TEST_WORK_DIR}/bin/main.zro")
        message(FATAL_ERROR "Regression compile failed (${status}): ${output}\n${error}")
    endif()
    file(RENAME "${TEST_WORK_DIR}/src" "${TEST_WORK_DIR}/source-hidden")
endif()
execute_process(COMMAND "${CLI_EXE}" "${project}" --execution-mode "${EXECUTION_MODE}" --emit-executed-via
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 40)
string(REPLACE "\r\n" "\n" output "${output}")
string(STRIP "${output}" output)
if(NOT status EQUAL 0 OR NOT output STREQUAL "42\nexecuted_via=${EXECUTION_MODE}")
    message(FATAL_ERROR "Regression ${EXECUTION_MODE} failed (${status}): ${output}\n${error}")
endif()
