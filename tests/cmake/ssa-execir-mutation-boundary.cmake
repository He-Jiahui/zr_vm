# Register declaration-only checks; the checker never links or executes a probe.
include_guard(GLOBAL)

function(_zr_execir_boundary_bracket out value)
    set(_equals "")
    while (TRUE)
        string(FIND "${value}" "]${_equals}]" _closing)
        if (_closing EQUAL -1)
            break()
        endif ()
        string(APPEND _equals "=")
    endwhile ()
    set(${out} "[${_equals}[${value}]${_equals}]" PARENT_SCOPE)
endfunction()

function(zr_ssa_register_execir_mutation_boundary source_root)
    get_property(_registered GLOBAL PROPERTY ZR_SSA_EXECIR_MUTATION_BOUNDARY_REGISTERED)
    if (_registered)
        return()
    endif ()
    if (NOT IS_ABSOLUTE "${source_root}" OR NOT CMAKE_C_COMPILER)
        message(FATAL_ERROR "ExecIR header boundary requires an absolute source root and a C compiler")
    endif ()
    file(REAL_PATH "${source_root}" _source_root)
    file(REAL_PATH "${CMAKE_BINARY_DIR}" _binary_root)
    set(_output_root "${_binary_root}/ssa-execir-mutation-boundary")
    set(_checker "${_source_root}/tests/cmake/ssa-execir-mutation-boundary-check.cmake")
    set(_probe "${_source_root}/tests/parser/test_ssa_exec_ir_header_boundary.c")
    if (NOT EXISTS "${_checker}" OR NOT EXISTS "${_probe}")
        message(FATAL_ERROR "ExecIR header boundary checker or permanent probe is missing")
    endif ()
    set(_run_label "")
    if (DEFINED ZR_SSA_EXECIR_MUTATION_RUN_LABEL)
        set(_run_label "${ZR_SSA_EXECIR_MUTATION_RUN_LABEL}")
    endif ()
    set(_metadata "# Generated compiler/path metadata only; no source body.\n")
    foreach (_entry IN ITEMS
            SOURCE_ROOT C_COMPILER C_COMPILER_ID C_COMPILER_VERSION
            C_COMPILER_FRONTEND_VARIANT SYSTEM_NAME C_FLAGS OUTPUT_ROOT RUN_LABEL)
        if (_entry STREQUAL "SOURCE_ROOT")
            set(_value "${_source_root}")
        elseif (_entry STREQUAL "OUTPUT_ROOT")
            set(_value "${_output_root}")
        elseif (_entry STREQUAL "RUN_LABEL")
            set(_value "${_run_label}")
        else ()
            set(_value "${CMAKE_${_entry}}")
        endif ()
        _zr_execir_boundary_bracket(_quoted "${_value}")
        string(APPEND _metadata "set(ZR_BOUNDARY_${_entry} ${_quoted})\n")
    endforeach ()
    file(MAKE_DIRECTORY "${_output_root}")
    set(_params "${_output_root}/params.cmake")
    file(WRITE "${_params}" "${_metadata}")
    add_test(NAME ssa_execir_mutation_boundary
            COMMAND "${CMAKE_COMMAND}" "-DZR_EXECIR_BOUNDARY_PARAMS=${_params}"
            -P "${_checker}")
    set_tests_properties(ssa_execir_mutation_boundary PROPERTIES
            LABELS "ssa;execir;header-boundary;compile-only"
            WORKING_DIRECTORY "${_binary_root}")
    set_property(GLOBAL PROPERTY ZR_SSA_EXECIR_MUTATION_BOUNDARY_REGISTERED TRUE)
endfunction()
