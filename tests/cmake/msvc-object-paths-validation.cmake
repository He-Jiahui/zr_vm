cmake_minimum_required(VERSION 3.20)

foreach (required BUILD_DIR NINJA_EXE)
    if (NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif ()
endforeach ()

get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
if (NOT EXISTS "${BUILD_DIR}/build.ninja")
    message(FATAL_ERROR "A configured Ninja build is required: ${BUILD_DIR}")
endif ()
execute_process(
        COMMAND "${NINJA_EXE}" -C "${BUILD_DIR}" -t targets all
        RESULT_VARIABLE query_result
        OUTPUT_VARIABLE query_output
        ERROR_VARIABLE query_error
)
if (NOT query_result STREQUAL "0")
    message(FATAL_ERROR "Ninja target query failed (${query_result}):\n${query_output}${query_error}")
endif ()

string(REPLACE "\r\n" "\n" query_output "${query_output}")
string(REPLACE "\r" "\n" query_output "${query_output}")
string(REPLACE "\\" "/" query_output "${query_output}")
string(REPLACE "\n" ";" target_lines "${query_output}")
set(object_count 0)
set(longest_object_path 0)
set(overlong_objects)
foreach (target IN LISTS target_lines)
    if (target MATCHES "^(.+\\.obj): [A-Za-z0-9_]+_COMPILER__[^ \t]+$")
        get_filename_component(object_path "${CMAKE_MATCH_1}" ABSOLUTE BASE_DIR "${BUILD_DIR}")
        string(LENGTH "${object_path}" object_length)
        math(EXPR object_count "${object_count} + 1")
        if (object_length GREATER longest_object_path)
            set(longest_object_path "${object_length}")
        endif ()
        if (object_length GREATER_EQUAL 260)
            list(APPEND overlong_objects "${object_length}: ${object_path}")
        endif ()
    endif ()
endforeach ()
if (object_count EQUAL 0)
    message(FATAL_ERROR "Ninja returned no compiler-object targets")
endif ()
if (overlong_objects)
    list(JOIN overlong_objects "\n  " overlong_report)
    message(FATAL_ERROR "MSVC compiler object paths must contain fewer than 260 characters:\n  ${overlong_report}")
endif ()
message(STATUS "Audited ${object_count} compiler-object paths; longest path contains ${longest_object_path} characters")
