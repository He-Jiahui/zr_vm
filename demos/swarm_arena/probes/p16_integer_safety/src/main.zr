let system = import("zr.system");
var rng: int = 12345;
var i = 0;
while (i < 10000) { rng = (rng * 16807) % 2147483647; i += 1; }
if (rng != 710614072) { throw "P16 Park-Miller golden mismatch"; }
var hash: int = (2147483646 * 65599 + 2147483646) % 2147483647;
if (hash != 2147418047) { throw "P16 bounded hash golden mismatch"; }
var u: uint = 4294967295;
var next = u + 1;
if (next != 4294967296) { throw "P16 uint is not wide enough for bounded arithmetic"; }
system.console.printLine("PROBE_OK P16 rng=" + <string> rng + " hash=" + <string> hash + " uintNext=" + <string> next);
return 0;
