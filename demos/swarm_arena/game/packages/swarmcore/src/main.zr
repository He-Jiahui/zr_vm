let exception = import("zr.system.exception");

// Use the supported v1 dependency spelling import("&swarmcore").
// Products stay below 2^63; checked integer arithmetic never wraps here.
pub class Rng {
    pub var state: int;
    pub @constructor(seed: int) {
        if (seed < 1 || seed >= 2147483647) {
            throw new exception.RuntimeError("seed must be in 1..2147483646");
        }
        this.state = seed;
    }
    pub static fn advance(state: int): int { return (state * 48271) % 2147483647; }
    pub fn next(): int {
        this.state = Rng.advance(this.state);
        return this.state;
    }
}

pub fn nextState(state: int): int { return Rng.advance(state); }

pub fn mix(hash: int, value: int): int {
    var q = value % 1000000007;
    if (q < 0) { q += 1000000007; }
    return (hash * 31 + q) % 1000000007;
}

pub fn quantize(value: float): int { return <int>(value * 16.0); }
pub fn mixPosition(hash: int, value: float): int { return mix(hash, quantize(value)); }
