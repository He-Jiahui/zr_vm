let container = import("zr.container");
let exception = import("zr.system.exception");

// Hit carries a stable enemy ID: dense slots can change while events drain.
union GameEvent {
    Nothing;
    Hit(id: int, damage: int);
    EnemyKilled(id: int, kind: int, boss: int, x: float, y: float);
    PlayerHit(damage: int);
}

// Concrete union storage avoids the imported generic-constructor limitation.
pub class EventQueue {
    pri var items: zr.container.Array<GameEvent>;
    pri var head: int = 0;
    pri var size: int = 0;
    pri var cap: int;
    pub var tag: int = 0;
    pub var id: int = 0;
    pub var damage: int = 0;
    pub var x: float = 0.0;
    pub var y: float = 0.0;
    pub var kind: int = 0;
    pub var boss: int = 0;
    pub @constructor(cap: int) {
        if (cap <= 0) { throw new exception.RuntimeError("queue capacity must be positive"); }
        this.cap = cap;
        this.items = new container.Array<GameEvent>();
        var i = 0;
        while (i < cap) { this.items.add(GameEvent.Nothing); i += 1; }
    }
    pub fn count(): int { return this.size; }
    pub fn hit(id: int, damage: int): bool {
        if (this.size == this.cap) { return false; }
        var ev = GameEvent.Hit(id, damage);
        this.items[(this.head + this.size) % this.cap] = ev;
        this.size += 1; return true;
    }
    pub fn killedKind(id: int, kind: int, boss: int, x: float, y: float): bool {
        if (this.size == this.cap) { return false; }
        var ev = GameEvent.EnemyKilled(id, kind, boss, x, y);
        this.items[(this.head + this.size) % this.cap] = ev;
        this.size += 1; return true;
    }
    pub fn killed(id: int, x: float, y: float): bool {
        return this.killedKind(id, 0, 0, x, y);
    }
    pub fn playerHit(damage: int): bool {
        if (this.size == this.cap) { return false; }
        var ev = GameEvent.PlayerHit(damage);
        this.items[(this.head + this.size) % this.cap] = ev;
        this.size += 1; return true;
    }
    // Construct and switch on union values only in their declaring module.
    // Scalar enqueue arguments and decoded fields avoid cross-module union
    // exports and union out/method arguments; no decoded object is allocated.
    pub fn pop(): bool {
        this.tag = 0; this.id = 0; this.damage = 0; this.x = 0.0; this.y = 0.0;
        this.kind = 0; this.boss = 0;
        if (this.size == 0) { return false; }
        var ev = this.items[this.head];
        this.head = (this.head + 1) % this.cap;
        this.size -= 1;
        switch (ev) {
            (Nothing) { }
            (Hit(id, damage)) { this.tag = 1; this.id = id; this.damage = damage; }
            (EnemyKilled(id, kind, boss, x, y)) {
                this.tag = 2; this.id = id; this.kind = kind; this.boss = boss; this.x = x; this.y = y;
            }
            (PlayerHit(damage)) { this.tag = 3; this.damage = damage; }
        }
        return true;
    }
}
