let container = import("zr.container");
let core = import("&swarmcore");

// One smoke wave. Requests are a preallocated SoA, consumed in phase 3.
pub class Director {
    pub var pending: int = 0;
    pub var xs: zr.container.Array<float>;
    pub var ys: zr.container.Array<float>;
    pub @constructor() {
        this.xs = new container.Array<float>(); this.ys = new container.Array<float>();
        var i = 0;
        while (i < 200) { this.xs.add(0.0); this.ys.add(0.0); i += 1; }
    }
    pub fn advance(frame: int, alive: int, rng: core.Rng, x: float, y: float): void {
        this.pending = 0;
        if (frame != 0 && frame % 6 != 0) { return; }
        var amount = 4;
        if (frame == 0) { amount = 200; }
        if (amount > 200 - alive) { amount = 200 - alive; }
        var i = 0;
        while (i < amount) {
            var radius = 192 + rng.next() % 257;
            var offset = rng.next() % (radius * 2 + 1) - radius;
            var side = rng.next() % 4;
            var sx = x + <float>offset;
            var sy = y + <float>radius;
            if (side == 1) { sy = y - <float>radius; }
            else if (side == 2) { sx = x + <float>radius; sy = y + <float>offset; }
            else if (side == 3) { sx = x - <float>radius; sy = y + <float>offset; }
            this.xs[i] = sx; this.ys[i] = sy; i += 1;
        }
        this.pending = amount;
    }
}
