let container = import("zr.container");
let math = import("zr.math");

pub class Bot {
    pub var x: float = 2048.0;
    pub var y: float = 2048.0;
    pub var hp: int = 100;
    pub var immuneUntil: int = 0;
    pri var xs: zr.container.Array<float>;
    pri var ys: zr.container.Array<float>;
    pub @constructor(frames: int) {
        let math = import("zr.math");
        this.xs = new container.Array<float>(); this.ys = new container.Array<float>();
        var i = 1;
        while (i <= frames) {
            this.xs.add(2048.0 + 128.0 * math.sin(<float>i * 6.283185307179586 / 240.0));
            this.ys.add(2048.0 + 96.0 * math.sin(<float>i * 6.283185307179586 / 180.0));
            i += 1;
        }
    }
    pub fn input(frame: int): void { this.x = this.xs[frame]; this.y = this.ys[frame]; }
}
