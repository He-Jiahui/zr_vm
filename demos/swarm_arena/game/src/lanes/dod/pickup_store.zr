let container = import("zr.container");
let exception = import("zr.system.exception");

pub class Pickups {
    pub var count: int = 0;
    pub var cap: int;
    pub var px: zr.container.Array<float>;
    pub var py: zr.container.Array<float>;
    pub var value: zr.container.Array<int>;
    pub @constructor(cap: int) {
        this.cap = cap;
        this.px = new container.Array<float>(); this.py = new container.Array<float>();
        this.value = new container.Array<int>();
        var i = 0;
        while (i < cap) { this.px.add(0.0); this.py.add(0.0); this.value.add(0); i += 1; }
    }
    pub fn add(x: float, y: float, value: int): void {
        if (this.count == this.cap) { throw new exception.RuntimeError("pickup capacity exceeded"); }
        this.px[this.count] = x; this.py[this.count] = y; this.value[this.count] = value;
        this.count += 1;
    }
    pub fn swapRemove(slot: int): void {
        var last = this.count - 1;
        this.px[slot] = this.px[last]; this.py[slot] = this.py[last]; this.value[slot] = this.value[last];
        this.count = last;
    }
}

