let pickup_store = import("lanes/dod/pickup_store");
let bullet_store = import("lanes/dod/bullet_store");
let config = import("config");
let core = import("&swarmcore");
let events = import("events");
let director = import("director");
let player = import("player");
let world = import("lanes/dod/world");
let grid = import("lanes/dod/grid");
let systems = import("lanes/dod/systems");
let render = import("render");
let render_buffer = import("render_buffer");
let exception = import("zr.system.exception");

// Session is shared by CLI and host drive. Host module state stays empty until boot.
pub class Session {
    pri var booted: bool = false;
    pri var cfg: config.Config;
    pri var rng: core.Rng;
    pri var wave: director.Director;
    pri var p: player.Bot;
    pri var w: world.World;
    pri var bullets: bullet_store.Bullets;
    pri var particles: world.MovingSoA;
    pri var pickups: pickup_store.Pickups;
    pri var queue: events.EventQueue;
    pri var g: grid.Grid;
    pri var batch: render_buffer.Buffer;
    pri var framesDone: int = 0;
    pri var hash: int = 1;
    pri var hash60: int = 0;
    pri var sprites: int = 0;
    pri var enemiesMax: int = 0;
    pri var bulletsMax: int = 0;
    pri var particlesMax: int = 0;
    pub @constructor() { }
    pub fn boot(cfg: config.Config): void {
        if (this.booted) { throw new exception.RuntimeError("session already booted"); }
        this.cfg = cfg; this.rng = new core.Rng(cfg.seed);
        this.wave = new director.Director(cfg.enemyCap, cfg.waveFrames, cfg.ringRadius);
        this.p = new player.Bot(cfg.frames); this.p.baseAimed = cfg.aimedCount; this.p.aimedCount = cfg.aimedCount;
        var bulletCap = (cfg.aimedCount + 8) * 90 + 64;
        var pickupCap = cfg.enemyCap * 2 + 256;
        this.w = new world.World(cfg.enemyCap); this.bullets = new bullet_store.Bullets(bulletCap);
        this.pickups = new pickup_store.Pickups(pickupCap);
        this.particles = new world.MovingSoA(cfg.particleCap);
        this.queue = new events.EventQueue(8 * bulletCap + 64);
        this.g = new grid.Grid(cfg.enemyCap);
        this.batch = new render_buffer.Buffer(1 + cfg.enemyCap + bulletCap + cfg.particleCap + pickupCap);
        this.framesDone = 0; this.hash = 1; this.hash60 = 0; this.booted = true;
        this.enemiesMax = 0; this.bulletsMax = 0; this.particlesMax = 0;
    }
    pub fn tick(frame: int): int {
        let systems = import("lanes/dod/systems");
        if (!this.booted || frame != this.framesDone || frame >= this.cfg.frames) {
            throw new exception.RuntimeError("tick requires the next configured frame");
        }
        {
            this.p.input(frame); this.p.dodge(this.w);                             // 1 input
            this.wave.advance(frame, this.w.count, this.rng, this.p.x, this.p.y);  // 2 director
            var i = 0;
            while (i < this.wave.pending) {                                       // 3 spawn
                this.w.spawn(this.wave.xs[i], this.wave.ys[i], this.w.nextId,
                             this.wave.kinds[i], this.wave.bosses[i]);
                this.w.nextId += 1; i += 1;
            }
            this.g.build(this.w);                                                 // 4 grid
            systems.steer(this.w, this.p, this.g);                                // 5 steer
            systems.integrate(this.w);                                           // 6 integrate
            this.p.fire(this.w, this.bullets, frame);                              // 7 fire
            systems.moveBullets(this.bullets);                                    // 8 bullets
            systems.collide(this.w, this.bullets, this.g, this.queue, this.p, frame); // 9 collide
            this.rng.state = systems.drain(this.w, this.particles, this.queue, this.p,
                                          this.pickups, this.rng.state, this.cfg.particlesPerKill); // 10 events
            systems.move(this.particles);                                         // 11 particles
            this.rng.state = systems.magnet(this.pickups, this.p, this.rng.state);  // 12 pickups
            this.hash = systems.cheapHash(this.w, this.bullets, this.p, this.wave,
                                         this.pickups, this.rng.state, frame + 1, this.hash);
            if ((frame + 1) % 60 == 0) {                                         // 13 hash
                this.hash = systems.positionsHash(this.w, this.bullets, this.p, this.pickups, this.hash);
            }
            if (frame == 59) { this.hash60 = this.hash; }
            this.framesDone += 1;
            if (this.w.count > this.enemiesMax) { this.enemiesMax = this.w.count; }
            if (this.bullets.motion.count > this.bulletsMax) { this.bulletsMax = this.bullets.motion.count; }
            if (this.particles.count > this.particlesMax) { this.particlesMax = this.particles.count; }
        }
        return this.hash;
    }
    pub fn render(frame: int): int {                                              // 14 render
        let renderer = import("render");
        if (!this.booted || frame + 1 != this.framesDone) {
            throw new exception.RuntimeError("render requires the completed tick");
        }
        this.sprites = renderer.submit(this.w, this.bullets.motion, this.particles, this.pickups, this.p, this.batch, frame);
        return this.sprites;
    }
    pub fn fullHash(): int { let systems = import("lanes/dod/systems"); return systems.positionsHash(this.w, this.bullets, this.p, this.pickups, this.hash); }
    pub fn summary(hash: int, drive: string): string {
        return "SWARM_OK scenario=" + this.cfg.scenario + " lane=dod mode=" + drive + " frames=" + <string>this.framesDone
            + " hash=" + <string>hash + " seed=" + <string>this.cfg.seed + " hash60=" + <string>this.hash60
            + " enemies=" + <string>this.w.count + " bullets=" + <string>this.bullets.motion.count
            + " particles=" + <string>this.particles.count + " shots=" + <string>this.w.shots
            + " hits=" + <string>this.w.hits + " kills=" + <string>this.w.kills + " score=" + <string>this.w.score
            + " pickups=" + <string>this.pickups.count + " drops=" + <string>this.w.drops
            + " collected=" + <string>this.p.collected + " level=" + <string>this.p.level + " xp=" + <string>this.p.xp
            + " damage=" + <string>this.p.damage + " pierce_upgrade=" + <string>this.p.pierce
            + " aimed_count=" + <string>this.p.aimedCount + " radial_count=" + <string>this.p.radialCount
            + " magnet_radius=" + <string><int>this.p.magnetRadius + " upgrades_hash=" + <string>this.p.upgradesHash
            + " wave=" + <string>this.wave.waveIndex + " boss_waves=" + <string>this.wave.bossWaves
            + " burst_spawns=" + <string>this.wave.burstSpawns
            + " player_hp=" + <string>this.p.hp + " sprites=" + <string>this.sprites
            + " render_hash=" + <string>this.batch.lastHash;
    }
    pub fn entityMax(kind: int): int {
        if (kind == 0) { return this.enemiesMax; }
        if (kind == 1) { return this.bulletsMax; }
        if (kind == 2) { return this.particlesMax; }
        throw new exception.RuntimeError("unknown entity kind");
    }
    pub fn rendered(hash: int): void { this.batch.lastHash = hash; }
    pub fn shutdown(): void { this.booted = false; }
}
