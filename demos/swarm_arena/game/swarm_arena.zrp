{
  "manifestVersion": 1,
  "name": "swarm_arena",
  "version": "0.1.0",
  "kind": "application",
  "source": "src",
  "binary": "bin",
  "entry": "main",
  "testSource": "tests",
  "build": {
    "features": ["trace"],
    "profiles": {
      "debug": { "enableFeatures": ["trace"] },
      "release": { "enableFeatures": [] }
    }
  },
  "dependencies": {
    "$swarmcore": { "version": "0.1.0", "path": "packages/swarmcore/swarmcore.zrp" }
  }
}
