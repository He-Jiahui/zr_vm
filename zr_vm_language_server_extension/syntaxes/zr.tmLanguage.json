{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zr",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#union-declarations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#union-variants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zr",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zr",
          "match": "\\b(if|else|switch|case|default|while|for|break|continue|return|try|catch|finally|throw|yield|await|require)\\b"
        },
        {
          "name": "keyword.other.zr",
          "match": "\\b(module|union|struct|class|interface|enum|delegate|super|get|set|property|where)\\b"
        },
        {
          "name": "storage.type.function.zr",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.operator.construct.zr",
          "match": "\\b(init|new|own|move|drop)\\b"
        },
        {
          "name": "support.function.intrinsic.zr",
          "match": "\\b(import|typeid|typeof|loadModule|loadPlugin)\\b"
        },
        {
          "name": "constant.language.zr",
          "match": "\\b(true|false|null|Infinity|NegativeInfinity|NaN)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.function.zr",
          "match": "\\b(fn)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.function.zr"
            },
            "2": {
              "name": "entity.name.function.zr"
            }
          }
        },
        {
          "name": "meta.declaration.type.zr",
          "match": "\\b((?:(?:readonly|ref|resource)\\s+)*)(struct|class|interface|enum|union)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.type.zr"
            },
            "2": {
              "name": "storage.type.declaration.zr"
            },
            "3": {
              "name": "entity.name.type.zr"
            }
          }
        },
        {
          "name": "meta.declaration.native.extern.zr",
          "match": "\\b(native)\\s+(extern)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.native.zr"
            },
            "2": {
              "name": "keyword.control.extern.zr"
            }
          }
        },
        {
          "name": "meta.declaration.property.zr",
          "match": "\\b(property)\\s+([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.property.zr"
            },
            "2": {
              "name": "entity.name.property.zr"
            }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.binding.zr",
          "match": "\\b(let|var)\\b"
        },
        {
          "name": "storage.modifier.reference.zr",
          "match": "\\b(ref|in|out|scoped|readonly)\\b"
        },
        {
          "name": "storage.modifier.capability.zr",
          "match": "\\b(pub|pri|pro|static|abstract|virtual|override|final|shadow|const|async|native|extern|resource|comptime)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.zr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zr",
              "match": "\\\\[nrtbf\"'\\\\]|\\\\x[0-9a-fA-F]{2}|\\\\u[0-9a-fA-F]{4}"
            }
          ]
        },
        {
          "name": "string.quoted.single.zr",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zr",
              "match": "\\\\[nrtbf\"'\\\\]|\\\\x[0-9a-fA-F]{2}|\\\\u[0-9a-fA-F]{4}"
            }
          ]
        },
        {
          "name": "constant.numeric.hex.zr",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.zr",
          "match": "\\b0[0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.zr",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?[fFdD]?\\b|\\b\\d+[eE][+-]?\\d+[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.integer.zr",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "union-declarations": {
      "patterns": [
        {
          "name": "meta.declaration.union.zr",
          "match": "\\b(union)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.union.zr"
            },
            "2": {
              "name": "entity.name.type.union.zr"
            }
          }
        }
      ]
    },
    "union-variants": {
      "patterns": [
        {
          "name": "meta.union.variant.default.zr",
          "match": "(@)\\s*([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.default-variant.zr"
            },
            "2": {
              "name": "entity.name.type.variant.zr"
            }
          }
        },
        {
          "name": "meta.union.variant.declaration.zr",
          "match": "^\\s*(@)?\\s*([A-Z][a-zA-Z0-9_]*)\\b(?=\\s*(?:[({;]))",
          "captures": {
            "1": {
              "name": "punctuation.definition.default-variant.zr"
            },
            "2": {
              "name": "entity.name.type.variant.zr"
            }
          }
        },
        {
          "name": "variable.parameter.union.payload.zr",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\b(?=\\s*:)",
          "captures": {
            "1": {
              "name": "variable.parameter.union.payload.zr"
            }
          }
        },
        {
          "name": "variable.other.member.variant.zr",
          "match": "(?<=\\.)\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.function-arrow.zr",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.zr",
          "match": "(?:[+\\-*/%]|<<|>>)?="
        },
        {
          "name": "keyword.operator.range.zr",
          "match": "\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.zr",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.zr",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.zr",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.zr",
          "match": "[&|^~]|<<|>>"
        },
        {
          "name": "keyword.operator.other.zr",
          "match": "\\?|:|\\."
        },
        {
          "name": "keyword.operator.special.zr",
          "match": "@"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.zr",
          "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|usize|isize|float|float32|float64|double|bool|char|string|void|never|any|object|Int|Float|Double|Bool|Char|String|Void|Any|Object)\\b"
        },
        {
          "name": "entity.name.type.zr",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.namespace.zr",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\.)\\b"
        },
        {
          "name": "variable.other.member.zr",
          "match": "(?<=\\.)\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.function.zr",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.attribute.zr",
          "begin": "(#)(?=[A-Za-z_])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.begin.zr"
            }
          },
          "end": "(#)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.end.zr"
            }
          },
          "patterns": [
            {
              "name": "entity.name.function.attribute.zr",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*\\b"
            },
            {
              "include": "#literals"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.zr"
}
