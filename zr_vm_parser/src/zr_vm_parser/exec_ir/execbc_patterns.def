/*
 * Canonical generated-fusion pattern schema.
 *
 * ZR_EXECBC_FUSION(name, head opcode, tail opcode, constraint mask,
 *                  result form, dispatch benefit, boundary mask)
 *
 * The fields are deliberately symbolic and contain no executable predicate.
 * scripts/codegen/generate_execbc_patterns.py is the sole producer of the
 * corresponding metadata header.
 */
ZR_EXECBC_FUSION(LOAD_ADD_INT, LOAD, ADD,
                 ZR_EXEC_BC_FUSION_CONSTRAINT_TYPED_OPERANDS | ZR_EXEC_BC_FUSION_CONSTRAINT_SAME_RESULT_OPERAND | ZR_EXEC_BC_FUSION_CONSTRAINT_NO_INTERVENING_EFFECT | ZR_EXEC_BC_FUSION_CONSTRAINT_RESULT_SINGLE_USE,
                 ZR_EXEC_BC_FUSION_RESULT_OF_TAIL, 1, ZR_EXEC_BC_FUSION_BOUNDARY_NONE)
ZR_EXECBC_FUSION(COMPARE_BRANCH_INT, COMPARE, CONDITIONAL_BRANCH,
                 ZR_EXEC_BC_FUSION_CONSTRAINT_TYPED_OPERANDS | ZR_EXEC_BC_FUSION_CONSTRAINT_SAME_RESULT_OPERAND | ZR_EXEC_BC_FUSION_CONSTRAINT_NO_INTERVENING_EFFECT | ZR_EXEC_BC_FUSION_CONSTRAINT_RESULT_SINGLE_USE | ZR_EXEC_BC_FUSION_CONSTRAINT_BRANCH_TARGET | ZR_EXEC_BC_FUSION_CONSTRAINT_PRESERVE_BOUNDARY,
                 ZR_EXEC_BC_FUSION_RESULT_NONE, 1, ZR_EXEC_BC_FUSION_BOUNDARY_DEBUG | ZR_EXEC_BC_FUSION_BOUNDARY_SAFEPOINT)
ZR_EXECBC_FUSION(INDEX_LOAD_STORE, PLACE_PROJECT, LOAD,
                 ZR_EXEC_BC_FUSION_CONSTRAINT_TYPED_OPERANDS | ZR_EXEC_BC_FUSION_CONSTRAINT_SAME_RESULT_OPERAND | ZR_EXEC_BC_FUSION_CONSTRAINT_NO_INTERVENING_EFFECT | ZR_EXEC_BC_FUSION_CONSTRAINT_RESULT_SINGLE_USE | ZR_EXEC_BC_FUSION_CONSTRAINT_LAYOUT_PROVEN | ZR_EXEC_BC_FUSION_CONSTRAINT_INDEX_STORE_VARIANT | ZR_EXEC_BC_FUSION_CONSTRAINT_PRESERVE_BOUNDARY,
                 ZR_EXEC_BC_FUSION_RESULT_OF_TAIL, 1, ZR_EXEC_BC_FUSION_BOUNDARY_EXCEPTION)
ZR_EXECBC_FUSION(BINDING_CALL, PLACE_PROJECT, CALL,
                 ZR_EXEC_BC_FUSION_CONSTRAINT_TYPED_OPERANDS | ZR_EXEC_BC_FUSION_CONSTRAINT_SAME_RESULT_OPERAND | ZR_EXEC_BC_FUSION_CONSTRAINT_NO_INTERVENING_EFFECT | ZR_EXEC_BC_FUSION_CONSTRAINT_RESULT_SINGLE_USE | ZR_EXEC_BC_FUSION_CONSTRAINT_BINDING_RESOLVED | ZR_EXEC_BC_FUSION_CONSTRAINT_PRESERVE_BOUNDARY,
                 ZR_EXEC_BC_FUSION_RESULT_OF_TAIL, 1, ZR_EXEC_BC_FUSION_BOUNDARY_EXCEPTION | ZR_EXEC_BC_FUSION_BOUNDARY_REENTRANT)
ZR_EXECBC_FUSION(INCREMENT_LOOP_BRANCH, ADD, CONDITIONAL_BRANCH,
                 ZR_EXEC_BC_FUSION_CONSTRAINT_TYPED_OPERANDS | ZR_EXEC_BC_FUSION_CONSTRAINT_SAME_RESULT_OPERAND | ZR_EXEC_BC_FUSION_CONSTRAINT_NO_INTERVENING_EFFECT | ZR_EXEC_BC_FUSION_CONSTRAINT_RESULT_SINGLE_USE | ZR_EXEC_BC_FUSION_CONSTRAINT_BRANCH_TARGET,
                 ZR_EXEC_BC_FUSION_RESULT_NONE, 1, ZR_EXEC_BC_FUSION_BOUNDARY_DEBUG | ZR_EXEC_BC_FUSION_BOUNDARY_SAFEPOINT)
ZR_EXECBC_FUSION(CALL_RETURN, CALL, RETURN,
                 ZR_EXEC_BC_FUSION_CONSTRAINT_SAME_RESULT_OPERAND | ZR_EXEC_BC_FUSION_CONSTRAINT_NO_INTERVENING_EFFECT | ZR_EXEC_BC_FUSION_CONSTRAINT_RESULT_SINGLE_USE | ZR_EXEC_BC_FUSION_CONSTRAINT_BINDING_RESOLVED | ZR_EXEC_BC_FUSION_CONSTRAINT_PRESERVE_BOUNDARY,
                 ZR_EXEC_BC_FUSION_RESULT_NONE, 1, ZR_EXEC_BC_FUSION_BOUNDARY_EXCEPTION | ZR_EXEC_BC_FUSION_BOUNDARY_REENTRANT)
